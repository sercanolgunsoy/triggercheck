root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cshtml}]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_style = space
indent_size = 2

# Formatting rules checked by `dotnet format --verify-no-changes` in CI. They describe the existing compact code
# style (short statements / blocks and object-initializer members on one line are allowed).
[*.cs]
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
csharp_indent_case_contents_when_block = false
