@page
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Plans.IndexModel
@{ ViewData["Title"] = "Planlar"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Planlar</h2>
    <a asp-page="Create" class="btn btn-primary">+ Yeni plan</a>
</div>

<div class="card">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr><th>Plan</th><th>Min. aralık</th><th class="text-end">Maks. monitör</th><th class="text-end">Saklama</th><th class="text-end">Aylık ücret</th><th>Durum</th><th class="text-end">Müşteri (aktif)</th><th class="text-end">Monitör</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Rows)
    {
        <tr>
            <td class="fw-semibold">@p.Name</td>
            <td>@SaFormat.Interval(p.MinIntervalSeconds)</td>
            <td class="text-end">@p.MaxMonitors.ToString("N0")</td>
            <td class="text-end">@p.RetentionDays gün</td>
            <td class="text-end">@SaFormat.Money(p.MonthlyPrice)</td>
            <td>@if (p.IsActive) { <span class="badge bg-success">Aktif</span> } else { <span class="badge bg-secondary">Pasif</span> }</td>
            <td class="text-end"><a asp-page="/Customers/Index" asp-route-planId="@p.Id">@p.Customers</a> (@p.ActiveCustomers)</td>
            <td class="text-end">@p.Monitors</td>
            <td class="text-end text-nowrap">
                <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline" onsubmit="return confirm('@p.Name planı silinsin mi?');">
                    @if (p.Customers > 0) { <button class="btn btn-sm btn-outline-danger" disabled title="Kullanımda olan plan silinemez">Sil</button> }
                    else { <button class="btn btn-sm btn-outline-danger">Sil</button> }
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
<p class="small text-muted mt-2">Pasif planlar yeni müşterilere sunulmaz; mevcut müşteriler planlarını korur. Müşterisi olan plan silinemez.</p>
