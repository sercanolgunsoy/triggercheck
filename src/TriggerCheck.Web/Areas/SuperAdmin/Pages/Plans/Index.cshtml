@page
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Plans.IndexModel
@{ ViewData["Title"] = L["Plans"]; }

<div class="page-head">
    <h2 class="mb-0">@L["Plans"]</h2>
    <a asp-page="Create" class="btn btn-primary">@Icons.Get("plus", 16) @L["New plan"]</a>
</div>

<div class="card">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr><th>@L["Plan"]</th><th>@L["Min. interval"]</th><th class="text-end">@L["Max monitors"]</th><th class="text-end">@L["Retention"]</th><th class="text-end">@L["Monthly price"]</th><th>@L["Status"]</th><th class="text-end">@L["Customers (active)"]</th><th class="text-end">@L["Monitors"]</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Rows)
    {
        <tr>
            <td class="fw-semibold">@p.Name</td>
            <td>@Fmt.Interval(p.MinIntervalSeconds)</td>
            <td class="text-end">@Fmt.Number(p.MaxMonitors)</td>
            <td class="text-end">@L["{0} days", Fmt.Number(p.RetentionDays)]</td>
            <td class="text-end">@Fmt.Money(p.MonthlyPrice)</td>
            <td>@if (p.IsActive) { <span class="badge bg-success">@L["Active"]</span> } else { <span class="badge bg-secondary">@L["Inactive"]</span> }</td>
            <td class="text-end"><a asp-page="/Customers/Index" asp-route-planId="@p.Id">@p.Customers</a> (@p.ActiveCustomers)</td>
            <td class="text-end">@Fmt.Number(p.Monitors)</td>
            <td class="text-end text-nowrap">
                <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">@L["Edit"]</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline" data-confirm="@L["Delete the plan {0}?", p.Name]">
                    @if (p.Customers > 0) { <button class="btn btn-sm btn-outline-danger" disabled title="@L["A plan in use cannot be deleted"]">@L["Delete"]</button> }
                    else { <button class="btn btn-sm btn-outline-danger">@L["Delete"]</button> }
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
<p class="small text-muted mt-2">@L["Inactive plans are not offered to new customers; existing customers keep their plan. A plan that has customers cannot be deleted."]</p>
