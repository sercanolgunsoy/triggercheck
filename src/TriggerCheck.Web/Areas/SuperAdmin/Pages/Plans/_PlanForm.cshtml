@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Plans.PlanInput
@*
    Shared plan form fields. Render with <partial name="_PlanForm" for="Input" /> so field names bind to Input.*.
*@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="MinIntervalSeconds" class="form-label"></label>
        <select asp-for="MinIntervalSeconds" class="form-select">
            @foreach (var s in PlanRules.SupportedIntervals)
            {
                <option value="@s">@Fmt.Interval(s)@(s >= 60 ? $" ({L["{0} sec", s]})" : "")</option>
            }
        </select>
        <span asp-validation-for="MinIntervalSeconds" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="MaxMonitors" class="form-label"></label>
        <input asp-for="MaxMonitors" class="form-control" type="number" min="1" />
        <span asp-validation-for="MaxMonitors" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="RetentionDays" class="form-label"></label>
        <input asp-for="RetentionDays" class="form-control" type="number" min="1" max="3650" />
        <span asp-validation-for="RetentionDays" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="MonthlyPrice" class="form-label"></label>
        <input asp-for="MonthlyPrice" class="form-control" type="number" min="0" step="0.01" value="@(Model.MonthlyPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        <span asp-validation-for="MonthlyPrice" class="text-danger small"></span>
    </div>
</div>
<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label"></label>
</div>
<div class="form-check mb-3">
    <input asp-for="AllowsSmsVoice" class="form-check-input" />
    <label asp-for="AllowsSmsVoice" class="form-check-label"></label>
    <div class="form-text">@L["Customers on this plan can add SMS and voice call alert channels. They are only offered when Twilio is configured for this installation."]</div>
</div>
<div class="form-check mb-3">
    <input asp-for="AllowsSelfSignup" class="form-check-input" />
    <label asp-for="AllowsSelfSignup" class="form-check-label"></label>
    <div class="form-text">@L["Offered on the sign-up page (with a free trial for paid plans) and on the customers' Billing page. Turn off for sales-led plans such as Enterprise."]</div>
</div>
<fieldset class="border rounded p-3 mb-3">
    <legend class="fs-6 fw-semibold float-none w-auto px-1 mb-0">@L["iyzico subscription"]</legend>
    <div class="form-text mb-2">@L["Create the product and a monthly pricing plan in the iyzico merchant panel and paste their reference codes here. Paid plans without a pricing plan code cannot be bought online."]</div>
    <div class="row">
        <div class="col-md-6 mb-2">
            <label asp-for="IyzicoProductReferenceCode" class="form-label"></label>
            <input asp-for="IyzicoProductReferenceCode" class="form-control font-monospace" />
            <span asp-validation-for="IyzicoProductReferenceCode" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-2">
            <label asp-for="IyzicoPricingPlanReferenceCode" class="form-label"></label>
            <input asp-for="IyzicoPricingPlanReferenceCode" class="form-control font-monospace" />
            <span asp-validation-for="IyzicoPricingPlanReferenceCode" class="text-danger small"></span>
        </div>
    </div>
</fieldset>

<fieldset class="border rounded p-3 mb-3" id="plan-ai">
    <legend class="fs-6 fw-semibold w-auto px-1 mb-1">@L["AI features"]</legend>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="AiMonthlyCallLimit" class="form-label"></label>
            <input asp-for="AiMonthlyCallLimit" class="form-control" type="number" min="0" />
            <span asp-validation-for="AiMonthlyCallLimit" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="AiMonthlyTokenLimit" class="form-label"></label>
            <input asp-for="AiMonthlyTokenLimit" class="form-control" type="number" min="0" />
            <span asp-validation-for="AiMonthlyTokenLimit" class="text-danger small"></span>
        </div>
    </div>
    @foreach (var f in AiFeatures.All)
    {
        var id = "ai-feature-" + f.Name;
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="@Html.NameFor(m => m.AiFeatures)" value="@f.Name" id="@id" checked="@Model.AiFeatures.Contains(f.Name)" />
            <label class="form-check-label" for="@id">@f.Name <span class="text-muted small">(@f.BacklogId)</span></label>
        </div>
    }
    <div class="form-text">@L["Monthly AI budget per customer on this plan. When it is used up, AI output is skipped until next month; monitoring is not affected. 0 AI calls = no AI."]</div>
</fieldset>
