@page
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Monitors.IndexModel
@{
    ViewData["Title"] = "Tüm monitörler";
    var from = Model.Total == 0 ? 0 : (Model.PageNo - 1) * IndexModel.PageSize + 1;
    var to = Math.Min(Model.Total, Model.PageNo * IndexModel.PageSize);
    Dictionary<string, string> RouteFor(int page)
    {
        var d = new Dictionary<string, string> { ["p"] = page.ToString() };
        if (Model.CustomerId is int cid) d["customerId"] = cid.ToString();
        if (Model.Status is MonitorStatus st) d["status"] = st.ToString();
        if (Model.Type is MonitorType ty) d["type"] = ty.ToString();
        if (!string.IsNullOrWhiteSpace(Model.Q)) d["q"] = Model.Q;
        return d;
    }
}

<h2 class="mb-3">Tüm monitörler</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select asp-for="CustomerId" class="form-select">
            <option value="">Tüm müşteriler</option>
            @foreach (var c in Model.Customers) { <option value="@c.Id">@c.Name</option> }
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Status" class="form-select">
            <option value="">Tüm durumlar</option>
            <option value="Up">UP</option>
            <option value="Down">DOWN</option>
            <option value="Paused">Duraklatıldı</option>
            <option value="Unknown">Bekliyor</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Type" class="form-select">
            <option value="">Tüm tipler</option>
            @foreach (var t in Enum.GetValues<MonitorType>()) { <option value="@t">@SaFormat.TypeName(t)</option> }
        </select>
    </div>
    <div class="col-md-3">
        <input asp-for="Q" class="form-control" placeholder="Hedef / ad ara" />
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
    </div>
</form>

<div class="card">
<div class="table-responsive">
<table class="table table-sm table-hover align-middle mb-0">
    <thead class="table-light">
        <tr><th>Müşteri</th><th>Monitör</th><th>Tip</th><th>Aralık</th><th>Son kontrol (@SaFormat.TzLabel)</th><th class="text-end">Yanıt</th><th>Durum</th><th></th></tr>
    </thead>
    <tbody>
    @if (Model.Rows.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Monitör bulunamadı.</td></tr> }
    @foreach (var m in Model.Rows)
    {
        <tr>
            <td>
                <a asp-page="/Customers/Details" asp-route-id="@m.CustomerId">@m.CustomerName</a>
                @if (!m.CustomerActive) { <span class="badge bg-danger">askıda</span> }
            </td>
            <td>@m.Name<div class="small text-muted text-break">@m.Target@(m.Port is int port ? ":" + port : "")</div></td>
            <td>@SaFormat.TypeName(m.Type)</td>
            <td>@SaFormat.Interval(m.IntervalSeconds)</td>
            <td class="text-nowrap">@SaFormat.Time(m.LastCheckedAtUtc)</td>
            <td class="text-end">@(m.LastResponseTimeMs is int ms ? ms + " ms" : "—")</td>
            <td><span title="@m.LastError"><partial name="_StatusBadge" model="m.Status" /></span></td>
            <td class="text-end">
                <form method="post" class="d-inline" asp-route-id="@m.Id" asp-page-handler="@(m.IsEnabled ? "Pause" : "Resume")"
                      asp-route-customerId="@Model.CustomerId" asp-route-status="@Model.Status" asp-route-type="@Model.Type" asp-route-q="@Model.Q" asp-route-p="@Model.PageNo">
                    @if (m.IsEnabled) { <button class="btn btn-sm btn-outline-secondary">Duraklat</button> }
                    else { <button class="btn btn-sm btn-outline-success">Devam ettir</button> }
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <small class="text-muted">@from–@to / @Model.Total monitör</small>
    @if (Model.PageCount > 1)
    {
        <nav><ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.PageNo <= 1 ? "disabled" : "")"><a class="page-link" asp-all-route-data="RouteFor(Model.PageNo - 1)">‹ Önceki</a></li>
            @for (var i = Math.Max(1, Model.PageNo - 3); i <= Math.Min(Model.PageCount, Model.PageNo + 3); i++)
            {
                <li class="page-item @(i == Model.PageNo ? "active" : "")"><a class="page-link" asp-all-route-data="RouteFor(i)">@i</a></li>
            }
            <li class="page-item @(Model.PageNo >= Model.PageCount ? "disabled" : "")"><a class="page-link" asp-all-route-data="RouteFor(Model.PageNo + 1)">Sonraki ›</a></li>
        </ul></nav>
    }
</div>
