@page "{customerId:int}/{userId}"
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Customers.ResetPasswordModel
@{ ViewData["Title"] = "Şifre sıfırla"; }

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">Müşteriler</a></li>
    <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@Model.CustomerId">@Model.TargetUser.Customer?.Name</a></li>
    <li class="breadcrumb-item active">Şifre sıfırla</li>
</ol></nav>

<div class="row"><div class="col-lg-6">
<h2 class="mb-3">Şifre sıfırla</h2>
<p class="text-muted">Kullanıcı: <strong>@Model.TargetUser.Email</strong> (@Model.TargetUser.FullName)</p>
<form method="post" class="card"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
        <div class="form-text">Kullanıcının açık oturumları sonlandırılır ve hesap kilidi kaldırılır.</div>
    </div>
    <button type="submit" class="btn btn-primary">Şifreyi sıfırla</button>
    <a asp-page="Details" asp-route-id="@Model.CustomerId" class="btn btn-link">Vazgeç</a>
</div></form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
