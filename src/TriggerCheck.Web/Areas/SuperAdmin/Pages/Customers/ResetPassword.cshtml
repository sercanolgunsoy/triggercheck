@page "{customerId:int}/{userId}"
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Customers.ResetPasswordModel
@{ ViewData["Title"] = L["Reset password"]; }

<nav aria-label="@L["Breadcrumb"]"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Customers"]</a></li>
    <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@Model.CustomerId">@Model.TargetUser.Customer?.Name</a></li>
    <li class="breadcrumb-item active">@L["Reset password"]</li>
</ol></nav>

<div class="row"><div class="col-lg-6">
<h2 class="mb-3">@L["Reset password"]</h2>
<p class="text-muted">@L["User:"] <strong>@Model.TargetUser.Email</strong> (@Model.TargetUser.FullName)</p>
<form method="post" class="card"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
        <div class="form-text">@L["The user's open sessions are ended and the account is unlocked."]</div>
    </div>
    <button type="submit" class="btn btn-primary">@L["Reset password"]</button>
    <a asp-page="Details" asp-route-id="@Model.CustomerId" class="btn btn-link">@L["Cancel"]</a>
</div></form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
