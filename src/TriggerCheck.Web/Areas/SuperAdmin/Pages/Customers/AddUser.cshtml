@page "{customerId:int}"
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Customers.AddUserModel
@{ ViewData["Title"] = "Kullanıcı ekle"; }

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">Müşteriler</a></li>
    <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@Model.Customer.Id">@Model.Customer.Name</a></li>
    <li class="breadcrumb-item active">Kullanıcı ekle</li>
</ol></nav>

<div class="row"><div class="col-lg-6">
<h2 class="mb-3">Kullanıcı ekle</h2>
<form method="post" class="card"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.FullName" class="form-label"></label>
        <input asp-for="Input.FullName" class="form-control" />
        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
        <div class="form-text">En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Role" class="form-label"></label>
        <select asp-for="Input.Role" class="form-select">
            <option value="@Roles.CustomerAdmin">CustomerAdmin: tam yetki</option>
            <option value="@Roles.CustomerViewer">CustomerViewer: salt okunur</option>
        </select>
        <span asp-validation-for="Input.Role" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Ekle</button>
    <a asp-page="Details" asp-route-id="@Model.Customer.Id" class="btn btn-link">Vazgeç</a>
</div></form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
