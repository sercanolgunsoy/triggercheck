@page "{id:int}"
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Customers.EditModel
@{ ViewData["Title"] = L["Edit customer"]; }

<nav aria-label="@L["Breadcrumb"]"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Customers"]</a></li>
    <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@Model.Customer.Id">@Model.Customer.Name</a></li>
    <li class="breadcrumb-item active">@L["Edit"]</li>
</ol></nav>

<h2 class="mb-3">@L["Edit customer"]</h2>

<div class="row g-4">
    <div class="col-lg-6">
        <form method="post" class="card"><div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ContactEmail" class="form-label"></label>
                <input asp-for="Input.ContactEmail" class="form-control" />
                <span asp-validation-for="Input.ContactEmail" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PlanId" class="form-label"></label>
                <select asp-for="Input.PlanId" class="form-select">
                    @foreach (var p in Model.Plans)
                    {
                        <option value="@p.Id">@p.Name@(p.IsActive ? "" : $" ({L["inactive"]})"): @L["min. {0}, max. {1} monitors", Fmt.Interval(p.MinIntervalSeconds), Fmt.Number(p.MaxMonitors)]</option>
                    }
                </select>
                <span asp-validation-for="Input.PlanId" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
            <a asp-page="Details" asp-route-id="@Model.Customer.Id" class="btn btn-link">@L["Cancel"]</a>
        </div></form>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-semibold">@L["Impact of a plan change"]</div>
            <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>@L["Plan"]</th><th>@L["Min. interval"]</th><th class="text-end">@L["Monitors to slow down"]</th><th class="text-end">@L["Monitor limit"]</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Plans)
                {
                    var fast = Model.FastMonitorsPerPlan[p.Id];
                    var over = Model.MonitorCount > p.MaxMonitors;
                    <tr class="@(p.Id == Model.Customer.PlanId ? "table-primary" : "")">
                        <td>@p.Name @if (p.Id == Model.Customer.PlanId) { <small class="text-muted">(@L["current"])</small> }</td>
                        <td>@Fmt.Interval(p.MinIntervalSeconds)</td>
                        <td class="text-end @(fast > 0 ? "text-warning fw-semibold" : "")">@fast</td>
                        <td class="text-end @(over ? "text-danger fw-semibold" : "")">@Model.MonitorCount / @p.MaxMonitors</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            <div class="card-footer small text-muted">
                @L["When moving to a slower plan, monitors faster than the plan minimum are automatically slowed down to the plan minimum."]
                @L["If the number of monitors exceeds the limit of the new plan, the monitors are not deleted; the customer cannot add new monitors."]
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
