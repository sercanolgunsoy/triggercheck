@page "{id:int}"
@model TriggerCheck.Web.Areas.SuperAdmin.Pages.Customers.DetailsModel
@{
    var c = Model.Customer;
    ViewData["Title"] = c.Name;
    var overLimit = Model.Monitors.Count > c.Plan.MaxMonitors;
}

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Customers"]</a></li>
    <li class="breadcrumb-item active">@c.Name</li>
</ol></nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">
        @c.Name
        @if (c.IsActive) { <span class="badge bg-success fs-6 align-middle">@L["Active"]</span> }
        else { <span class="badge bg-danger fs-6 align-middle">@L["Suspended"]</span> }
    </h2>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-outline-secondary">@L["Edit / change plan"]</a>
        @if (c.IsActive)
        {
            <form method="post" asp-page-handler="Suspend" asp-route-id="@c.Id" data-confirm="@L["Suspend the customer? All its users are signed out and its monitors are no longer checked."]" onsubmit="return confirm(this.dataset.confirm);">
                <button class="btn btn-warning">@L["Suspend"]</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Activate" asp-route-id="@c.Id">
                <button class="btn btn-success">@L["Activate"]</button>
            </form>
        }
        <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger">@L["Delete"]</a>
    </div>
</div>

@if (!c.IsActive)
{
    <div class="alert alert-warning">@L["This customer is suspended: its users cannot sign in and its monitors are not checked."]</div>
}
@if (overLimit)
{
    <div class="alert alert-warning">@L["The number of monitors ({0}) exceeds the limit of the plan ({1}). The customer cannot add new monitors.", Model.Monitors.Count, c.Plan.MaxMonitors]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100"><div class="card-header fw-semibold">@L["Customer details"]</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">@L["Contact e-mail"]</dt><dd class="col-7">@c.ContactEmail</dd>
                    <dt class="col-5">@L["Created"]</dt><dd class="col-7">@Fmt.Time(c.CreatedAtUtc) @Fmt.TimeZoneLabel</dd>
                    <dt class="col-5">@L["Alert channels"]</dt><dd class="col-7">@Model.AlertChannelCount</dd>
                    <dt class="col-5">@L["Open incidents"]</dt><dd class="col-7">@Model.OpenIncidents.Count</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100"><div class="card-header fw-semibold">@L["Plan"]: @c.Plan.Name @if (!c.Plan.IsActive) { <span class="badge bg-light text-dark border">@L["inactive plan"]</span> }</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">@L["Min. interval"]</dt><dd class="col-7">@Fmt.Interval(c.Plan.MinIntervalSeconds)</dd>
                    <dt class="col-5">@L["Monitors"]</dt><dd class="col-7 @(overLimit ? "text-danger fw-semibold" : "")">@Model.Monitors.Count / @c.Plan.MaxMonitors</dd>
                    <dt class="col-5">@L["Retention"]</dt><dd class="col-7">@L["{0} days", Fmt.Number(c.Plan.RetentionDays)]</dd>
                    <dt class="col-5">@L["Monthly price"]</dt><dd class="col-7">@Fmt.Money(c.Plan.MonthlyPrice)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>@L["Users"] (@Model.Users.Count)</span>
        <a asp-page="AddUser" asp-route-customerId="@c.Id" class="btn btn-sm btn-primary">+ @L["Add user"]</a>
    </div>
    <div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th>@L["E-mail"]</th><th>@L["Full name"]</th><th>@L["Role"]</th><th>@L["Status"]</th><th>@L["Created"]</th><th></th></tr></thead>
        <tbody>
        @if (Model.Users.Count == 0) { <tr><td colspan="6" class="text-muted text-center py-3">@L["No users."]</td></tr> }
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td><span class="badge @(u.Role.Contains(Roles.CustomerAdmin) ? "bg-primary" : "bg-info text-dark")">@u.Role</span></td>
                <td>
                    @if (u.IsActive) { <span class="badge bg-success">@L["Active"]</span> } else { <span class="badge bg-secondary">@L["Inactive"]</span> }
                    @if (u.LockedOut) { <span class="badge bg-warning text-dark">@L["Locked"]</span> }
                </td>
                <td>@Fmt.Date(u.CreatedAtUtc)</td>
                <td class="text-end text-nowrap">
                    <a asp-page="ResetPassword" asp-route-customerId="@c.Id" asp-route-userId="@u.Id" class="btn btn-sm btn-outline-secondary">@L["Reset password"]</a>
                    @if (u.LockedOut)
                    {
                        <form method="post" asp-page-handler="UnlockUser" asp-route-id="@c.Id" class="d-inline">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button class="btn btn-sm btn-outline-warning">@L["Unlock"]</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="ToggleUser" asp-route-id="@c.Id" class="d-inline">
                        <input type="hidden" name="userId" value="@u.Id" />
                        <button class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")">@(u.IsActive ? L["Deactivate"] : L["Activate"])</button>
                    </form>
                    <form method="post" asp-page-handler="DeleteUser" asp-route-id="@c.Id" class="d-inline" data-confirm="@L["Delete {0}?", u.Email]" onsubmit="return confirm(this.dataset.confirm);">
                        <input type="hidden" name="userId" value="@u.Id" />
                        <button class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>@L["Monitors"] (@Model.Monitors.Count)</span>
        <a asp-page="/Monitors/Index" asp-route-customerId="@c.Id" class="btn btn-sm btn-outline-secondary">@L["Show in all monitors"]</a>
    </div>
    <div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th>@L["Name"]</th><th>@L["Type"]</th><th>@L["Target"]</th><th>@L["Interval"]</th><th>@L["Last check ({0})", Fmt.TimeZoneLabel]</th><th class="text-end">@L["Response"]</th><th>@L["Status"]</th></tr></thead>
        <tbody>
        @if (Model.Monitors.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-3">@L["No monitors."]</td></tr> }
        @foreach (var m in Model.Monitors)
        {
            <tr>
                <td>@m.Name</td>
                <td>@Fmt.TypeName(m.Type)</td>
                <td class="small text-break">@m.Target@(m.Port is int port ? ":" + port : "")</td>
                <td>@Fmt.Interval(m.IntervalSeconds)</td>
                <td class="text-nowrap">@Fmt.Time(m.LastCheckedAtUtc)</td>
                <td class="text-end">@Fmt.Ms(m.LastResponseTimeMs)</td>
                <td><partial name="_StatusBadge" model="m.Status" /></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">@L["Open incidents"] (@Model.OpenIncidents.Count)</div>
    @if (Model.OpenIncidents.Count == 0)
    {
        <div class="card-body text-muted">@L["No open incidents."]</div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>@L["Started ({0})", Fmt.TimeZoneLabel]</th><th>@L["Monitor"]</th><th>@L["Cause"]</th></tr></thead>
            <tbody>
            @foreach (var i in Model.OpenIncidents)
            {
                <tr><td class="text-nowrap">@Fmt.Time(i.StartedAtUtc)</td><td>@i.Monitor.Name</td><td class="small">@i.Cause</td></tr>
            }
            </tbody>
        </table>
        </div>
    }
</div>
