@page "{id:int}"
@model TriggerCheck.Web.Areas.App.Pages.Incidents.DetailsModel
@{
    var i = Model.Incident;
    ViewData["Title"] = L["Incident #{0}", i.Id].Value;
    var isAdmin = User.IsInRole(Roles.CustomerAdmin);
}

<nav aria-label="@L["Breadcrumb"]"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Incidents"]</a></li>
    <li class="breadcrumb-item active">#@i.Id</li>
</ol></nav>

<h2 class="mb-3">@L["Incident #{0}", i.Id]
    @if (i.ResolvedAtUtc is null) { <span class="badge bg-danger fs-6 align-middle">@L["Open"]</span> } else { <span class="badge bg-success fs-6 align-middle">@L["Resolved"]</span> }
    @if (i.AcknowledgedAtUtc is not null) { <span class="badge bg-info text-dark fs-6 align-middle" id="ack-badge">@L["Acknowledged"]</span> }
</h2>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">@L["Monitor"]</dt><dd class="col-sm-8"><a asp-page="/Monitors/Details" asp-route-id="@i.MonitorId">@Model.MonitorName</a></dd>
                <dt class="col-sm-4">@L["Started"]</dt><dd class="col-sm-8">@Fmt.Time(i.StartedAtUtc) @Fmt.TimeZoneLabel</dd>
                <dt class="col-sm-4">@L["Ended"]</dt><dd class="col-sm-8">@(i.ResolvedAtUtc is null ? "—" : Fmt.Time(i.ResolvedAtUtc) + " " + Fmt.TimeZoneLabel)
                    @if (i.ResolvedDuringMaintenance) { <div class="small text-muted" id="maintenance-note">@L["Recovered during maintenance."]</div> }</dd>
                <dt class="col-sm-4">@L["Duration"]</dt><dd class="col-sm-8">@Fmt.Duration((i.ResolvedAtUtc ?? Model.NowUtc) - i.StartedAtUtc)@(i.ResolvedAtUtc is null ? " " + L["(ongoing)"].Value : "")</dd>
                <dt class="col-sm-4">@L["Cause"]</dt><dd class="col-sm-8 text-danger">@(i.Cause ?? "—")</dd>
                @if (Model.Group is { } grp)
                {
                    <dt class="col-sm-4">@L["Related incidents"]</dt>
                    <dd class="col-sm-8" id="incident-group">@if (grp.IsPrimary) { <span>@L["Primary incident of a group"]</span> } else { <span>@L["Grouped under"]</span> <a asp-page="Details" asp-route-id="@grp.PrimaryIncidentId">#@grp.PrimaryIncidentId</a> }
                        · <a asp-page="Groups">@L["Details"]</a></dd>
                }
                <dt class="col-sm-4">@L["Escalation"]</dt><dd class="col-sm-8">@(i.LastEscalationStep > 0 ? L["Escalated to step {0}", i.LastEscalationStep].Value : L["Not escalated"].Value)</dd>
                <dt class="col-sm-4">@L["Acknowledged"]</dt>
                <dd class="col-sm-8">
                    @if (i.AcknowledgedAtUtc is DateTime ackAt)
                    {
                        @L["{0} by {1}", Fmt.Time(ackAt) + " " + Fmt.TimeZoneLabel, Model.AcknowledgedBy ?? L["a deleted user"].Value]
                        @if (!string.IsNullOrEmpty(i.AcknowledgeNote)) { <div class="small text-muted" id="ack-note">@i.AcknowledgeNote</div> }
                    }
                    else
                    {
                        <span>@L["No"]</span>
                    }
                </dd>
            </dl>
        </div></div>
    </div>
    <div class="col-12 order-last" id="incident-ai">
        @if (Model.RelatedIncidentId is int related)
        {
            <div class="small text-muted mb-2" id="ai-related">@L["Other monitors on the same host failed at the same time. AI summary of the related incident:"] <a asp-page="Details" asp-route-id="@related">#@related</a></div>
        }
        <partial name="_AiPanel" model="Model.Ai" />
    </div>
    @if (isAdmin && i.ResolvedAtUtc is null && i.AcknowledgedAtUtc is null)
    {
        <div class="col-lg-5">
            <div class="card"><div class="card-body">
                <h3 class="h5 card-title">@L["Acknowledge"]</h3>
                <p class="small text-muted">@L["Acknowledging tells your team someone is working on it and stops further escalation steps. The monitor's status is not changed."]</p>
                <form method="post" asp-page-handler="Acknowledge" asp-route-id="@i.Id">
                    <label class="form-label" for="ack-note-input">@L["Note (optional)"]</label>
                    <textarea class="form-control mb-3" id="ack-note-input" name="note" maxlength="500" rows="2"></textarea>
                    <button type="submit" class="btn btn-primary">@L["Acknowledge"]</button>
                </form>
            </div></div>
        </div>
    }
</div>
