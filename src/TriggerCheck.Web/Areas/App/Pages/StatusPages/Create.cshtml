@page
@model TriggerCheck.Web.Areas.App.Pages.StatusPages.CreateModel
@{ ViewData["Title"] = L["New status page"].Value; }

<nav aria-label="@L["Breadcrumb"]"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Status pages"]</a></li>
    <li class="breadcrumb-item active">@L["New"]</li>
</ol></nav>

<h2 class="mb-3">@L["New status page"]</h2>
<div class="card"><div class="card-body">
    <form method="post">
        <partial name="_StatusPageForm" model="Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">@L["Add"]</button>
            <a asp-page="Index" class="btn btn-link">@L["Cancel"]</a>
        </div>
    </form>
</div></div>
