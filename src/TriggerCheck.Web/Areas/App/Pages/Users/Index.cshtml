@page
@model TriggerCheck.Web.Areas.App.Pages.Users.IndexModel
@{ ViewData["Title"] = L["Users"].Value; }

<div class="page-head">
    <div>
        <h2 class="mb-0">@L["Users"]</h2>
        <div class="text-muted small">@L["Admins can manage everything; viewers can only read."]</div>
    </div>
    <a class="btn btn-primary" asp-page="Create">@Icons.Get("plus", 16) @L["New user"]</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>@L["Full name"]</th><th>@L["E-mail"]</th><th>@L["Role"]</th><th>@L["Status"]</th><th>@L["Created ({0})", Fmt.TimeZoneLabel]</th><th></th></tr></thead>
        <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.FullName @if (u.IsSelf) { <span class="badge bg-info text-dark">@L["You"]</span> }</td>
                <td>@u.Email</td>
                <td>
                    @if (u.IsSelf)
                    {
                        @Fmt.RoleName(u.Role)
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ChangeRole" asp-route-id="@u.Id" class="d-flex gap-1">
                            <select name="role" class="form-select form-select-sm" style="width: auto">
                                <option value="@Roles.CustomerAdmin" selected="@(u.Role == Roles.CustomerAdmin)">@Fmt.RoleName(Roles.CustomerAdmin)</option>
                                <option value="@Roles.CustomerViewer" selected="@(u.Role == Roles.CustomerViewer)">@Fmt.RoleName(Roles.CustomerViewer)</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Save"]</button>
                        </form>
                    }
                </td>
                <td>@if (u.IsActive) { <span class="badge bg-success">@L["Active"]</span> } else { <span class="badge bg-secondary">@L["Inactive"]</span> }</td>
                <td class="small text-muted">@Fmt.Time(u.CreatedAtUtc)</td>
                <td class="text-end text-nowrap">
                    @if (!u.IsSelf)
                    {
                        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@u.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">@(u.IsActive ? L["Deactivate"] : L["Activate"])</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="d-inline"
                              data-confirm="@L["Delete user {0}? This cannot be undone.", u.Email]"
                              onsubmit="return confirm(this.dataset.confirm);">
                            <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
