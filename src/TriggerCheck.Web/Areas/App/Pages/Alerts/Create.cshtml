@page
@model TriggerCheck.Web.Areas.App.Pages.Alerts.CreateModel
@{ ViewData["Title"] = "Yeni bildirim kanalı"; }

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">Bildirim kanalları</a></li>
    <li class="breadcrumb-item active">Yeni</li>
</ol></nav>

<h2 class="mb-3">Yeni bildirim kanalı</h2>
<div class="card"><div class="card-body">
    <form method="post">
        <partial name="_AlertForm" for="Input" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Ekle</button>
            <a asp-page="Index" class="btn btn-link">İptal</a>
        </div>
    </form>
</div></div>
