@page
@model TriggerCheck.Web.Areas.App.Pages.Alerts.IndexModel
@{
    ViewData["Title"] = L["Alert channels"].Value;
    var isAdmin = User.IsInRole(Roles.CustomerAdmin);
}

<div class="page-head">
    <div>
        <h2 class="mb-0">@L["Alert channels"]</h2>
        <div class="text-muted small">@L["When your monitors go DOWN / UP, the enabled channels are notified."]</div>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-page="Create">@Icons.Get("plus", 16) @L["New channel"]</a>
    }
</div>

@if (Model.Channels.Count == 0)
{
    <div class="alert alert-light border">@L["No alert channels yet. Add an e-mail or webhook channel to hear about downtime."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>@L["Name"]</th><th>@L["Type"]</th><th>@L["Target"]</th><th>@L["Status"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Channels)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@AlertChannelInput.TypeName(c.Type, L)</td>
                    <td class="text-truncate font-monospace small" style="max-width: 320px">@AlertChannelInput.DisplayTarget(c)</td>
                    <td>@if (c.IsEnabled) { <span class="badge bg-success">@L["Enabled"]</span> } else { <span class="badge bg-secondary">@L["Disabled"]</span> }</td>
                    <td class="text-end text-nowrap">
                        @if (isAdmin)
                        {
                            <form method="post" asp-page-handler="Test" asp-route-id="@c.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@L["Send a test message to this channel now"]">@L["Send test"]</button>
                            </form>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@c.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning">@(c.IsEnabled ? L["Disable"] : L["Enable"])</button>
                            </form>
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@c.Id">@L["Edit"]</a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@c.Id">@L["Delete"]</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@{
    var contact = string.IsNullOrWhiteSpace(Model.ContactEmail) ? L["no contact e-mail set"].Value : Model.ContactEmail;
}
<div class="card mt-4" id="no-channel-setting">
    <div class="card-body">
        <h5 class="card-title">@L["When no channel is enabled"]</h5>
        <p class="text-muted small mb-3">@L["Alerts go to every enabled channel above. If no channel is enabled (none added, or all disabled), this setting decides what happens to DOWN / UP alerts. Disabling every channel therefore does not silence alerts unless you choose \"Do not send alerts\"."]</p>
        @if (!Model.AnyEnabled)
        {
            <div class="alert alert-warning small py-2">
                @(Model.FallbackToContactEmail
                    ? L["No channel is enabled: alerts are currently sent to {0}.", contact]
                    : L["No channel is enabled: alerts are currently not sent."])
            </div>
        }
        <form method="post" asp-page-handler="Fallback">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="sendToContactEmail" id="fallback-email" value="true"
                       checked="@Model.FallbackToContactEmail" disabled="@(!isAdmin)" />
                <label class="form-check-label" for="fallback-email">@L["Send alerts to the account contact e-mail ({0}) (default)", contact]</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="sendToContactEmail" id="fallback-none" value="false"
                       checked="@(!Model.FallbackToContactEmail)" disabled="@(!isAdmin)" />
                <label class="form-check-label" for="fallback-none">@L["Do not send alerts"]</label>
            </div>
            @if (isAdmin)
            {
                <button type="submit" class="btn btn-sm btn-primary mt-3">@L["Save"]</button>
            }
        </form>
    </div>
</div>
