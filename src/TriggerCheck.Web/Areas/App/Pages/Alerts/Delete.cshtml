@page "{id:int}"
@model TriggerCheck.Web.Areas.App.Pages.Alerts.DeleteModel
@{ ViewData["Title"] = L["Delete alert channel"].Value; }

<nav aria-label="@L["Breadcrumb"]"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Alert channels"]</a></li>
    <li class="breadcrumb-item active">@L["Delete"]</li>
</ol></nav>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">@L["Delete alert channel"]</div>
    <div class="card-body">
        <p>@Html.Raw(string.Format(Html.Encode(L["Are you sure you want to delete the channel {0} ({1}: {2})?"].Value),
               "<strong>" + Html.Encode(Model.Channel.Name) + "</strong>",
               Html.Encode(AlertChannelInput.TypeName(Model.Channel.Type, L)),
               "<span class=\"font-monospace\">" + Html.Encode(AlertChannelInput.DisplayTarget(Model.Channel)) + "</span>"))</p>
        <form method="post" asp-route-id="@Model.Channel.Id">
            <button type="submit" class="btn btn-danger">@L["Yes, delete"]</button>
            <a asp-page="Index" class="btn btn-link">@L["Cancel"]</a>
        </form>
    </div>
</div>
