@page "{id:int}"
@model TriggerCheck.Web.Areas.App.Pages.Alerts.EditModel
@{ ViewData["Title"] = "Bildirim kanalını düzenle"; }

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">Bildirim kanalları</a></li>
    <li class="breadcrumb-item active">Düzenle</li>
</ol></nav>

<h2 class="mb-3">Bildirim kanalını düzenle</h2>
<div class="card"><div class="card-body">
    <form method="post" asp-route-id="@Model.Id">
        <partial name="_AlertForm" for="Input" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-page="Index" class="btn btn-link">İptal</a>
        </div>
    </form>
</div></div>
