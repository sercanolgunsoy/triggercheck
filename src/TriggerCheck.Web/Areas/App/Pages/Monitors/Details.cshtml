@page "{id:int}"
@model TriggerCheck.Web.Areas.App.Pages.Monitors.DetailsModel
@{
    var m = Model.Monitor;
    ViewData["Title"] = m.Name;
    var isAdmin = User.IsInRole(Roles.CustomerAdmin);
    var isPaused = m.Status == MonitorStatus.Paused;
    var isHeartbeat = m.Type == MonitorType.Heartbeat;
    // Full ping URL: only right after it was issued, only to the admin who issued it (only its hash is stored).
    var newPingUrl = Model.NewPingUrl;
}

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Monitors"]</a></li>
    <li class="breadcrumb-item active">@m.Name</li>
</ol></nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="mb-1">@m.Name <partial name="_StatusBadge" model="m.Status" />
            @if (m.PendingConfirmationSinceUtc is not null && !isPaused)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 align-middle" id="confirming-badge">@L["Confirming failure…"]</span>
            }
            @if (Model.InMaintenance)
            {
                <span class="badge bg-info text-dark fs-6 align-middle maintenance-badge" id="maintenance-badge">@L["In maintenance"]</span>
            }
        </h2>
        <div class="text-muted">@Fmt.TypeName(m.Type) · <span class="font-monospace">@m.Target@(m.Port is int p ? ":" + p : "")</span>@(m.DnsRecordType is { } drt ? " · " + drt : "")</div>
    </div>
    @if (isAdmin)
    {
        <div class="d-flex flex-wrap gap-2">
            @if (!isPaused && !isHeartbeat)
            {
                <form method="post" asp-page-handler="CheckNow" asp-route-id="@m.Id">
                    <button type="submit" class="btn btn-outline-primary">@L["Check now"]</button>
                </form>
            }
            <form method="post" asp-page-handler="@(isPaused ? "Resume" : "Pause")" asp-route-id="@m.Id">
                <button type="submit" class="btn btn-outline-warning">@(isPaused ? L["Resume"] : L["Pause"])</button>
            </form>
            <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@m.Id">@L["Edit"]</a>
            <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@m.Id">@L["Delete"]</a>
        </div>
    }
</div>

@if (newPingUrl is not null)
{
    <div class="alert alert-success" id="heartbeat-url" role="status">
        <div class="fw-semibold mb-1">@L["Ping URL"]</div>
        <code class="d-block text-break user-select-all mb-2">@newPingUrl</code>
        <div class="small">@L["Copy it now: for security it is shown only once. If you lose it, generate a new one."]</div>
        <div class="small text-muted mt-1">@L["Example (cron):"] <code class="text-break">curl -fsS -m 10 --retry 3 @newPingUrl</code> · @L["report a failure with ?status=fail&msg=..."]</div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">@L["Status"]</dt><dd class="col-sm-7"><partial name="_StatusBadge" model="m.Status" />
                    @if (m.StatusChangedAtUtc is DateTime sc) { <span class="text-muted small">(@L["{0} ago", Fmt.Duration(DateTime.UtcNow - sc)])</span> }</dd>
                @if (isHeartbeat)
                {
                    <dt class="col-sm-5">@L["Expected ping interval"]</dt><dd class="col-sm-7">@Fmt.Interval(m.IntervalSeconds)</dd>
                    <dt class="col-sm-5">@L["Grace period"]</dt><dd class="col-sm-7">@Fmt.Duration(TimeSpan.FromSeconds(m.GracePeriodSeconds))</dd>
                    <dt class="col-sm-5">@L["Ping URL"]</dt>
                    <dd class="col-sm-7" id="heartbeat-info">
                        <span class="font-monospace">@m.Target</span>
                        @if (isAdmin)
                        {
                            <form method="post" asp-page-handler="RegenerateToken" asp-route-id="@m.Id" class="d-inline"
                                  data-confirm="@L["Generate a new ping URL? The current URL stops working immediately."]">
                                <button type="submit" class="btn btn-sm btn-link p-0 ms-2 align-baseline">@L["Generate new URL"]</button>
                            </form>
                        }
                    </dd>
                    <dt class="col-sm-5">@L["Last ping"]</dt>
                    <dd class="col-sm-7">@(m.LastHeartbeatAtUtc is null ? L["No ping received yet."].Value : Fmt.Time(m.LastHeartbeatAtUtc) + " " + Fmt.TimeZoneLabel)
                        @if (m.LastHeartbeatFailed) { <span class="badge bg-danger">@L["reported failure"]</span> }
                        @if (!string.IsNullOrEmpty(m.LastHeartbeatMessage)) { <div class="small text-muted text-break">@m.LastHeartbeatMessage</div> }
                    </dd>
                }
                else
                {
                    <dt class="col-sm-5">@L["Check interval"]</dt><dd class="col-sm-7">@Fmt.Interval(m.IntervalSeconds)</dd>
                    <dt class="col-sm-5">@L["Timeout"]</dt><dd class="col-sm-7">@Fmt.Interval(m.TimeoutSeconds)</dd>
                    <dt class="col-sm-5">@L["Failure threshold"]</dt><dd class="col-sm-7">@L["{0} (currently {1} consecutive failures)", m.FailureThreshold, m.ConsecutiveFailures]</dd>
                }
                @if (m.Type == MonitorType.Dns)
                {
                    <dt class="col-sm-5">@L["Record type"]</dt><dd class="col-sm-7">@m.DnsRecordType</dd>
                    <dt class="col-sm-5">@L["Expected value"]</dt>
                    <dd class="col-sm-7">@if (m.ExpectedValue is null) { <span class="text-muted">@L["any record"]</span> } else { <span>@MonitorInput.OperatorName(m.AssertionOperator ?? AssertionOperator.Equal, L) <code>@m.ExpectedValue</code></span> }</dd>
                }
                @if (m.Type == MonitorType.JsonApi)
                {
                    <dt class="col-sm-5">@L["JSON assertion"]</dt>
                    <dd class="col-sm-7" id="json-assertion"><code>@m.JsonPath</code> @(m.AssertionOperator is { } jop ? MonitorInput.OperatorName(jop, L) : "") @if (m.ExpectedValue is not null) { <code>@m.ExpectedValue</code> }</dd>
                }
                @if (MonitorInput.IsHttpType(m.Type))
                {
                    <dt class="col-sm-5">HTTP</dt><dd class="col-sm-7">@m.HttpMethod · @L["expected {0}", m.ExpectedStatusCodes]</dd>
                }
                @if (m.Type == MonitorType.Keyword)
                {
                    <dt class="col-sm-5">@L["Keyword"]</dt><dd class="col-sm-7"><code>@m.Keyword</code></dd>
                }
                <dt class="col-sm-5">@L["Last check"]</dt><dd class="col-sm-7">@Fmt.Time(m.LastCheckedAtUtc) @Fmt.TimeZoneLabel</dd>
                <dt class="col-sm-5">@L["Next check"]</dt><dd class="col-sm-7">@(isPaused ? "—" : Fmt.Time(m.NextCheckAtUtc) + " " + Fmt.TimeZoneLabel)</dd>
                @if (!isHeartbeat)
                {
                    <dt class="col-sm-5">@L["Last response time"]</dt><dd class="col-sm-7">@Fmt.Ms(m.LastResponseTimeMs)</dd>
                }
                <dt class="col-sm-5">@L["Last error"]</dt><dd class="col-sm-7 text-danger">@(m.LastError ?? "—")</dd>
                @if (Model.IsHttps)
                {
                    <dt class="col-sm-5">@L["TLS certificate"]</dt>
                    <dd class="col-sm-7" id="cert-info">
                        @if (m.CertExpiresAtUtc is DateTime exp)
                        {
                            var daysLeft = (int)Math.Floor((exp - DateTime.UtcNow).TotalDays);
                            // Same rule as the alert: within the configured window.
                            var expiring = m.CertWarnDays > 0 && exp - DateTime.UtcNow <= TimeSpan.FromDays(m.CertWarnDays);
                            <span class="@(m.CertError is not null || daysLeft < 0 ? "text-danger" : expiring ? "text-warning" : "")">
                                @(daysLeft < 0 ? L["expired on {0}", Fmt.Date(exp)] : L["expires {0} ({1} days left)", Fmt.Date(exp), daysLeft])
                            </span>
                            <div class="small text-muted text-break">@L["Issuer: {0}", m.CertIssuer ?? "—"]</div>
                            @if (m.CertError is not null) { <div class="small text-danger">@m.CertError</div> }
                        }
                        else
                        {
                            <span class="text-muted">@L["Not checked yet."]</span>
                        }
                        <div class="small text-muted">@L["Expiry warning: {0}", m.CertWarnDays > 0 ? L["{0} days before expiry", m.CertWarnDays].Value : L["Off"].Value]</div>
                    </dd>
                }
            </dl>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="row g-3">
            @foreach (var (label, s) in new[] { (L["Uptime, last 24 hours"].Value, Model.Stats24h), (L["Uptime, last 7 days"].Value, Model.Stats7d), (L["Uptime, last 30 days"].Value, Model.Stats30d) })
            {
                <div class="col-4">
                    <div class="card text-center h-100"><div class="card-body px-1">
                        <div class="fs-4 fw-semibold @(s?.UptimePercent is double u ? (u >= 99 ? "text-success" : u >= 95 ? "text-warning" : "text-danger") : "text-muted")">@Fmt.Percent(s?.UptimePercent)</div>
                        <div class="small text-muted">@label</div>
                        <div class="small text-muted">@L["avg. {0}", s?.AvgResponseMs is double a ? Fmt.Ms((int)Math.Round(a)) : "—"]</div>
                    </div></div>
                </div>
            }
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>@L["Response time ({0})", Fmt.TimeZoneLabel]</span>
        <nav class="btn-group btn-group-sm" aria-label="@L["Chart range"]">
            @foreach (var (key, label) in new[] { ("24h", L["24 hours"].Value), ("7d", L["7 days"].Value), ("30d", L["30 days"].Value) })
            {
                <a class="btn @(Model.Range == key ? "btn-primary" : "btn-outline-secondary")" asp-route-id="@m.Id" asp-route-range="@key"
                   aria-current="@(Model.Range == key ? "true" : null)">@label</a>
            }
        </nav>
    </div>
    <div class="card-body">
        @if (Model.Chart.Count == 0)
        {
            <div class="text-muted">@L["No check results in this period."]</div>
        }
        else
        {
            <div class="small text-muted mb-2">@L["Average and 95th percentile of successful checks; failed checks and incidents are marked in red."]</div>
            @if (Model.ChartMaintenanceBands.Count > 0)
            {
                <div class="small text-muted mb-2" id="maintenance-legend">@L["Grey bands are maintenance windows; checks in them are not counted."]</div>
            }
            <div class="tc-chart"><canvas id="rtChart" aria-label="@L["Response time chart"]" role="img"></canvas></div>
            @if (Model.HasPhaseData)
            {
                <h3 class="h6 mt-4 mb-1">@L["Phase breakdown (average, ms)"]</h3>
                <div class="small text-muted mb-2">@L["A reused connection has no DNS, connect or TLS phase; these phases count as 0 for it."]</div>
                <div class="tc-chart"><canvas id="phaseChart" aria-label="@L["Phase breakdown chart"]" role="img"></canvas></div>
            }
        }
    </div>
</div>

<partial name="_MonitorRegions" model="Model.Regions" />

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@L["Last 50 checks"]</div>
            <div class="table-responsive" style="max-height: 480px">
                <table class="table table-sm table-striped mb-0">
                    <thead class="sticky-top bg-body"><tr><th>@L["Time ({0})", Fmt.TimeZoneLabel]</th><th>@L["Result"]</th><th>@L["Code"]</th><th class="text-end">@L["Duration"]</th><th>@L["Phases"]</th><th>@L["Error"]</th></tr></thead>
                    <tbody>
                    @if (Model.RecentChecks.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">@L["No checks yet."]</td></tr>
                    }
                    @foreach (var c in Model.RecentChecks)
                    {
                        <tr>
                            <td class="text-nowrap">@Fmt.Time(c.CheckedAtUtc)</td>
                            <td>@if (c.IsUp) { <span class="badge bg-success">@Fmt.StatusName(MonitorStatus.Up)</span> } else { <span class="badge bg-danger">@Fmt.StatusName(MonitorStatus.Down)</span> }
                                @if (c.IsConfirmation) { <span class="badge text-bg-light border">@L["Confirmation check"]</span> }
                                @if (c.InMaintenance) { <span class="badge text-bg-light border">@L["Maintenance"]</span> }</td>
                            <td>@(c.StatusCode?.ToString() ?? "—")</td>
                            <td class="text-end">@Fmt.Ms(c.ResponseTimeMs)</td>
                            <td class="small text-muted text-nowrap">@Model.PhaseText(c)</td>
                            <td class="small text-danger">@c.Error</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">@L["Incidents"]</div>
            <ul class="list-group list-group-flush">
                @if (Model.Incidents.Count == 0)
                {
                    <li class="list-group-item text-muted">@L["No incidents recorded."]</li>
                }
                @foreach (var i in Model.Incidents)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <span>@if (i.ResolvedAtUtc is null) { <span class="badge bg-danger">@L["Open"]</span> } else { <span class="badge bg-success">@L["Resolved"]</span> }
                                @if (i.AcknowledgedAtUtc is not null) { <span class="badge bg-info text-dark">@L["Acknowledged"]</span> }
                                <a asp-page="/Incidents/Details" asp-route-id="@i.Id">@Fmt.Time(i.StartedAtUtc)</a></span>
                            <span class="text-muted">@Fmt.Duration((i.ResolvedAtUtc ?? DateTime.UtcNow) - i.StartedAtUtc)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(i.Cause)) { <div class="small text-muted">@i.Cause</div> }
                        @if (!string.IsNullOrEmpty(i.FailedRegions)) { <div class="small text-muted">@L["Failing regions: {0}", i.FailedRegions]</div> }
                        @if (i.ResolvedDuringMaintenance) { <div class="small text-muted">@L["Recovered during maintenance."]</div> }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Chart.Count > 0)
    {
        <script src="~/lib/chart.js/dist/chart.umd.js"></script>
        <script>
        (function () {
            var data = @Json.Serialize(Model.Chart);
            var incidents = @Json.Serialize(Model.ChartIncidents);
            var maintenance = @Json.Serialize(Model.ChartMaintenanceBands);
            var text = @Json.Serialize(new
            {
                avg = L["Average (ms)"].Value,
                p95 = L["95th percentile (ms)"].Value,
                failed = L["Failed checks"].Value,
                checks = L["Checks"].Value,
                incident = L["Incident"].Value,
                maintenance = L["Maintenance"].Value,
                dns = L["DNS"].Value,
                connect = L["Connect"].Value,
                tls = L["TLS"].Value,
                wait = L["Waiting (TTFB)"].Value,
                transfer = L["Transfer"].Value
            });
            if (typeof Chart === 'undefined') return;
            var root = document.documentElement;
            function token(name, fallback) { return getComputedStyle(root).getPropertyValue(name).trim() || fallback; }
            function isDark() { return root.getAttribute('data-bs-theme') === 'dark' || root.getAttribute('data-theme') === 'dark'; }
            // Categorical phase colors (validated for CVD separation in light and dark mode).
            function phaseColors() {
                return isDark() ? ['#3987e5', '#d95926', '#199e70', '#c98500', '#9085e9'] : ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#6250d6'];
            }
            var labels = data.map(function (p) { return p.label; });
            Chart.defaults.font.family = token('--tc-font', 'system-ui');
            Chart.defaults.color = token('--tc-muted', '#64748b');

            // Incident markers: a red line where an incident started and a light band until it was resolved.
            var incidentPlugin = {
                id: 'tcIncidents',
                beforeDatasetsDraw: function (chart) {
                    if (!incidents.length) return;
                    var x = chart.scales.x, a = chart.chartArea, ctx = chart.ctx;
                    var rgb = token('--tc-down-rgb', '225, 29, 72');
                    ctx.save();
                    incidents.forEach(function (i) {
                        var x1 = x.getPixelForValue(i.start);
                        var x2 = i.end === null ? a.right : x.getPixelForValue(i.end);
                        ctx.fillStyle = 'rgba(' + rgb + ', 0.08)';
                        ctx.fillRect(x1, a.top, Math.max(2, x2 - x1), a.bottom - a.top);
                        ctx.strokeStyle = 'rgba(' + rgb + ', 0.9)';
                        ctx.lineWidth = 2;
                        ctx.beginPath(); ctx.moveTo(x1, a.top); ctx.lineTo(x1, a.bottom); ctx.stroke();
                    });
                    ctx.restore();
                }
            };

            // Maintenance bands (FEAT-3): a grey band over the buckets covered by a maintenance window.
            var maintenancePlugin = {
                id: 'tcMaintenance',
                beforeDatasetsDraw: function (chart) {
                    if (!maintenance.length) return;
                    var x = chart.scales.x, a = chart.chartArea, ctx = chart.ctx;
                    var rgb = token('--tc-idle-rgb', '100, 116, 139');
                    var half = labels.length > 1 ? (x.getPixelForValue(1) - x.getPixelForValue(0)) / 2 : 4;
                    ctx.save();
                    ctx.fillStyle = 'rgba(' + rgb + ', 0.16)';
                    maintenance.forEach(function (m) {
                        var x1 = Math.max(a.left, x.getPixelForValue(m.start) - half);
                        var x2 = Math.min(a.right, x.getPixelForValue(m.end) + half);
                        ctx.fillRect(x1, a.top, Math.max(2, x2 - x1), a.bottom - a.top);
                    });
                    ctx.restore();
                }
            };

            function baseOptions(stacked) {
                var grid = token('--tc-border', '#e5e7eb');
                return {
                    maintainAspectRatio: false,
                    animation: false,
                    spanGaps: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: true, position: 'bottom', labels: { boxWidth: 12, boxHeight: 12 } },
                        tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 }
                    },
                    scales: {
                        y: { stacked: stacked, beginAtZero: true, title: { display: true, text: 'ms' }, grid: { color: grid }, border: { display: false } },
                        x: { ticks: { maxTicksLimit: 10, autoSkip: true, maxRotation: 0 }, grid: { display: false }, border: { color: grid } }
                    }
                };
            }

            var brand = token('--tc-brand', '#4f46e5');
            var down = token('--tc-down', '#e11d48');
            var rtOptions = baseOptions(false);
            rtOptions.plugins.tooltip.callbacks = {
                afterBody: function (items) {
                    var p = data[items[0].dataIndex], lines = [text.checks + ': ' + p.checks];
                    if (p.failures) lines.push(text.failed + ': ' + p.failures);
                    incidents.forEach(function (i) { if (i.start === items[0].dataIndex) lines.push(text.incident + ': ' + i.label); });
                    maintenance.forEach(function (m) { if (m.start <= items[0].dataIndex && items[0].dataIndex <= m.end) lines.push(text.maintenance + ': ' + m.label); });
                    return lines;
                }
            };
            var charts = [new Chart(document.getElementById('rtChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: text.avg,
                        data: data.map(function (p) { return p.avg; }),
                        borderColor: brand, backgroundColor: brand, borderWidth: 2, tension: 0.3, pointRadius: 0, pointHoverRadius: 4
                    }, {
                        label: text.p95,
                        data: data.map(function (p) { return p.p95; }),
                        borderColor: token('--tc-muted', '#64748b'), backgroundColor: token('--tc-muted', '#64748b'),
                        borderWidth: 2, borderDash: [5, 4], tension: 0.3, pointRadius: 0, pointHoverRadius: 4
                    }, {
                        label: text.failed,
                        data: data.map(function (p) { return p.failures > 0 ? 0 : null; }),
                        showLine: false, pointRadius: 5, pointHoverRadius: 6, pointStyle: 'triangle',
                        borderColor: down, backgroundColor: down
                    }]
                },
                options: rtOptions,
                plugins: [maintenancePlugin, incidentPlugin]
            })];

            var phaseCanvas = document.getElementById('phaseChart');
            if (phaseCanvas) {
                var keys = ['dns', 'connect', 'tls', 'wait', 'transfer'], colors = phaseColors();
                charts.push(new Chart(phaseCanvas, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: keys.map(function (k, n) {
                            return {
                                label: text[k],
                                data: data.map(function (p) { return p[k]; }),
                                borderColor: colors[n], backgroundColor: colors[n],
                                borderWidth: 1, fill: n === 0 ? 'origin' : '-1', pointRadius: 0, pointHoverRadius: 3, tension: 0.2
                            };
                        })
                    },
                    options: baseOptions(true),
                    plugins: [maintenancePlugin, incidentPlugin]
                }));
            }

            document.addEventListener('tc:theme', function () {
                var g = token('--tc-border', '#e5e7eb'), colors = phaseColors();
                Chart.defaults.color = token('--tc-muted', '#64748b');
                charts.forEach(function (chart, n) {
                    chart.options.scales.y.grid.color = g;
                    chart.options.scales.x.border.color = g;
                    if (n === 1) chart.data.datasets.forEach(function (d, i) { d.borderColor = d.backgroundColor = colors[i]; });
                    chart.update('none');
                });
            });
        })();
        </script>
    }
}
