@page "{id:int}"
@model TriggerCheck.Web.Areas.App.Pages.Monitors.DetailsModel
@{
    var m = Model.Monitor;
    ViewData["Title"] = m.Name;
    var isAdmin = User.IsInRole(Roles.CustomerAdmin);
    var isPaused = m.Status == MonitorStatus.Paused;
}

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-page="Index">@L["Monitors"]</a></li>
    <li class="breadcrumb-item active">@m.Name</li>
</ol></nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="mb-1">@m.Name <partial name="_StatusBadge" model="m.Status" /></h2>
        <div class="text-muted">@Fmt.TypeName(m.Type) · <span class="font-monospace">@m.Target@(m.Port is int p ? ":" + p : "")</span></div>
    </div>
    @if (isAdmin)
    {
        <div class="d-flex flex-wrap gap-2">
            @if (!isPaused)
            {
                <form method="post" asp-page-handler="CheckNow" asp-route-id="@m.Id">
                    <button type="submit" class="btn btn-outline-primary">@L["Check now"]</button>
                </form>
            }
            <form method="post" asp-page-handler="@(isPaused ? "Resume" : "Pause")" asp-route-id="@m.Id">
                <button type="submit" class="btn btn-outline-warning">@(isPaused ? L["Resume"] : L["Pause"])</button>
            </form>
            <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@m.Id">@L["Edit"]</a>
            <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@m.Id">@L["Delete"]</a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">@L["Status"]</dt><dd class="col-sm-7"><partial name="_StatusBadge" model="m.Status" />
                    @if (m.StatusChangedAtUtc is DateTime sc) { <span class="text-muted small">(@L["{0} ago", Fmt.Duration(DateTime.UtcNow - sc)])</span> }</dd>
                <dt class="col-sm-5">@L["Check interval"]</dt><dd class="col-sm-7">@Fmt.Interval(m.IntervalSeconds)</dd>
                <dt class="col-sm-5">@L["Timeout"]</dt><dd class="col-sm-7">@Fmt.Interval(m.TimeoutSeconds)</dd>
                <dt class="col-sm-5">@L["Failure threshold"]</dt><dd class="col-sm-7">@L["{0} (currently {1} consecutive failures)", m.FailureThreshold, m.ConsecutiveFailures]</dd>
                @if (m.Type is MonitorType.Http or MonitorType.Keyword)
                {
                    <dt class="col-sm-5">HTTP</dt><dd class="col-sm-7">@m.HttpMethod · @L["expected {0}", m.ExpectedStatusCodes]</dd>
                }
                @if (m.Type == MonitorType.Keyword)
                {
                    <dt class="col-sm-5">@L["Keyword"]</dt><dd class="col-sm-7"><code>@m.Keyword</code></dd>
                }
                <dt class="col-sm-5">@L["Last check"]</dt><dd class="col-sm-7">@Fmt.Time(m.LastCheckedAtUtc) @Fmt.TimeZoneLabel</dd>
                <dt class="col-sm-5">@L["Next check"]</dt><dd class="col-sm-7">@(isPaused ? "—" : Fmt.Time(m.NextCheckAtUtc) + " " + Fmt.TimeZoneLabel)</dd>
                <dt class="col-sm-5">@L["Last response time"]</dt><dd class="col-sm-7">@Fmt.Ms(m.LastResponseTimeMs)</dd>
                <dt class="col-sm-5">@L["Last error"]</dt><dd class="col-sm-7 text-danger">@(m.LastError ?? "—")</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="row g-3">
            @foreach (var (label, s) in new[] { (L["Uptime, last 24 hours"].Value, Model.Stats24h), (L["Uptime, last 7 days"].Value, Model.Stats7d), (L["Uptime, last 30 days"].Value, Model.Stats30d) })
            {
                <div class="col-4">
                    <div class="card text-center h-100"><div class="card-body px-1">
                        <div class="fs-4 fw-semibold @(s?.UptimePercent is double u ? (u >= 99 ? "text-success" : u >= 95 ? "text-warning" : "text-danger") : "text-muted")">@Fmt.Percent(s?.UptimePercent)</div>
                        <div class="small text-muted">@label</div>
                        <div class="small text-muted">@L["avg. {0}", s?.AvgResponseMs is double a ? Fmt.Ms((int)Math.Round(a)) : "—"]</div>
                    </div></div>
                </div>
            }
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">@L["Response time — last 24 hours ({0})", Fmt.TimeZoneLabel]</div>
    <div class="card-body">
        @if (Model.Chart.Count == 0)
        {
            <div class="text-muted">@L["No check results in the last 24 hours."]</div>
        }
        else
        {
            <div style="height: 260px"><canvas id="rtChart"></canvas></div>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@L["Last 50 checks"]</div>
            <div class="table-responsive" style="max-height: 480px">
                <table class="table table-sm table-striped mb-0">
                    <thead class="sticky-top bg-body"><tr><th>@L["Time ({0})", Fmt.TimeZoneLabel]</th><th>@L["Result"]</th><th>@L["Code"]</th><th class="text-end">@L["Duration"]</th><th>@L["Error"]</th></tr></thead>
                    <tbody>
                    @if (Model.RecentChecks.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">@L["No checks yet."]</td></tr>
                    }
                    @foreach (var c in Model.RecentChecks)
                    {
                        <tr>
                            <td class="text-nowrap">@Fmt.Time(c.CheckedAtUtc)</td>
                            <td>@if (c.IsUp) { <span class="badge bg-success">@Fmt.StatusName(MonitorStatus.Up)</span> } else { <span class="badge bg-danger">@Fmt.StatusName(MonitorStatus.Down)</span> }</td>
                            <td>@(c.StatusCode?.ToString() ?? "—")</td>
                            <td class="text-end">@Fmt.Ms(c.ResponseTimeMs)</td>
                            <td class="small text-danger">@c.Error</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">@L["Incidents"]</div>
            <ul class="list-group list-group-flush">
                @if (Model.Incidents.Count == 0)
                {
                    <li class="list-group-item text-muted">@L["No incidents recorded."]</li>
                }
                @foreach (var i in Model.Incidents)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <span>@if (i.ResolvedAtUtc is null) { <span class="badge bg-danger">@L["Open"]</span> } else { <span class="badge bg-success">@L["Resolved"]</span> }
                                @Fmt.Time(i.StartedAtUtc)</span>
                            <span class="text-muted">@Fmt.Duration((i.ResolvedAtUtc ?? DateTime.UtcNow) - i.StartedAtUtc)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(i.Cause)) { <div class="small text-muted">@i.Cause</div> }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Chart.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
        (function () {
            var data = @Json.Serialize(Model.Chart);
            if (typeof Chart === 'undefined') return;
            new Chart(document.getElementById('rtChart'), {
                type: 'line',
                data: {
                    labels: data.map(function (p) { return p.label; }),
                    datasets: [{
                        label: @Json.Serialize(L["Response time (ms)"].Value),
                        data: data.map(function (p) { return p.ms; }),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,0.1)',
                        fill: true,
                        tension: 0.2,
                        pointRadius: data.map(function (p) { return p.isUp ? 0 : 3; }),
                        pointBackgroundColor: data.map(function (p) { return p.isUp ? '#0d6efd' : '#dc3545'; })
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    animation: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, title: { display: true, text: 'ms' } }, x: { ticks: { maxTicksLimit: 12 } } }
                }
            });
        })();
        </script>
    }
}
