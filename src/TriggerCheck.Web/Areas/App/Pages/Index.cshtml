@page
@model TriggerCheck.Web.Areas.App.Pages.IndexModel
@{
    ViewData["Title"] = "Panel";
    var isAdmin = User.IsInRole(Roles.CustomerAdmin);
}
@section Head { <meta http-equiv="refresh" content="30" /> }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Panel</h2>
        <div class="text-muted small">@Model.CustomerName · sayfa 30 sn'de bir yenilenir · saatler @AppFormat.TimeZoneLabel</div>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-page="/Monitors/Create">+ Yeni monitör</a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md">
        <div class="card text-center border-success"><div class="card-body">
            <div class="display-6 text-success" data-testid="count-up">@Model.UpCount</div><div class="text-muted">Up</div>
        </div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-danger"><div class="card-body">
            <div class="display-6 text-danger" data-testid="count-down">@Model.DownCount</div><div class="text-muted">Down</div>
        </div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-secondary"><div class="card-body">
            <div class="display-6 text-secondary">@Model.PausedCount</div><div class="text-muted">Duraklatıldı</div>
        </div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-warning"><div class="card-body">
            <div class="display-6 text-warning">@Model.UnknownCount</div><div class="text-muted">Bekliyor</div>
        </div></div>
    </div>
    <div class="col-12 col-md">
        <div class="card text-center border-primary"><div class="card-body">
            <div class="display-6 text-primary">@AppFormat.Percent(Model.OverallUptime24h)</div><div class="text-muted">24 sa uptime</div>
        </div></div>
    </div>
</div>

@if (Model.OpenIncidents.Count > 0)
{
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">Açık olaylar (@Model.OpenIncidents.Count)</div>
        <ul class="list-group list-group-flush">
            @foreach (var i in Model.OpenIncidents)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span><a asp-page="/Monitors/Details" asp-route-id="@i.MonitorId">@i.MonitorName</a> — @(i.Cause ?? "Bilinmeyen hata")</span>
                    <span class="text-muted">@AppFormat.Time(i.StartedAtUtc) · @AppFormat.Duration(DateTime.UtcNow - i.StartedAtUtc)</span>
                </li>
            }
        </ul>
    </div>
}

<div class="card">
    <div class="card-header">Monitörler</div>
    @if (Model.Monitors.Count == 0)
    {
        <div class="card-body text-muted">
            Henüz monitör yok.
            @if (isAdmin) { <a asp-page="/Monitors/Create">İlk monitörünüzü ekleyin.</a> }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead><tr><th>Durum</th><th>Ad</th><th>Tip</th><th>Hedef</th><th class="text-end">Son yanıt</th><th class="text-end">24 sa uptime</th><th>Son kontrol</th></tr></thead>
                <tbody>
                @foreach (var m in Model.Monitors)
                {
                    <tr>
                        <td><partial name="_StatusBadge" model="m.Status" /></td>
                        <td><a asp-page="/Monitors/Details" asp-route-id="@m.Id">@m.Name</a></td>
                        <td>@AppFormat.TypeName(m.Type)</td>
                        <td class="text-truncate" style="max-width: 280px">@m.Target</td>
                        <td class="text-end">@AppFormat.Ms(m.LastResponseTimeMs)</td>
                        <td class="text-end">@AppFormat.Percent(m.Uptime24h)</td>
                        <td class="small text-muted">@AppFormat.Time(m.LastCheckedAtUtc)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
