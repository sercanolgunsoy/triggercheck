@page
@model TriggerCheck.Web.Areas.App.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Hesap & Plan";
    var plan = Model.Customer.Plan;
    var usage = plan.MaxMonitors > 0 ? Math.Min(100, 100.0 * Model.MonitorCount / plan.MaxMonitors) : 100;
}

<h2 class="mb-3">Hesap & Plan</h2>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Hesap</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Müşteri</dt><dd class="col-sm-8">@Model.Customer.Name</dd>
                    <dt class="col-sm-4">İletişim e-postası</dt><dd class="col-sm-8">@Model.Customer.ContactEmail</dd>
                    <dt class="col-sm-4">Kullanıcı</dt><dd class="col-sm-8">@Model.Email (@Model.RoleName)</dd>
                    <dt class="col-sm-4">Kayıt tarihi</dt><dd class="col-sm-8">@AppFormat.Time(Model.Customer.CreatedAtUtc) @AppFormat.TimeZoneLabel</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Plan: <strong>@plan.Name</strong></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">En kısa kontrol aralığı</dt><dd class="col-sm-8">@PlanRules.FormatInterval(plan.MinIntervalSeconds)</dd>
                    <dt class="col-sm-4">Kullanılabilir aralıklar</dt>
                    <dd class="col-sm-8">
                        @foreach (var i in Model.AllowedIntervals) { <span class="badge bg-primary me-1">@PlanRules.FormatInterval(i)</span> }
                    </dd>
                    <dt class="col-sm-4">Monitörler</dt>
                    <dd class="col-sm-8">
                        @Model.MonitorCount / @plan.MaxMonitors
                        <div class="progress mt-1" style="height: 6px">
                            <div class="progress-bar @(usage >= 90 ? "bg-danger" : usage >= 70 ? "bg-warning" : "bg-success")" style="width: @usage.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </dd>
                    <dt class="col-sm-4">Veri saklama</dt><dd class="col-sm-8">@plan.RetentionDays gün</dd>
                    <dt class="col-sm-4">Aylık ücret</dt><dd class="col-sm-8">@(plan.MonthlyPrice == 0 ? "Ücretsiz" : "$" + plan.MonthlyPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))</dd>
                </dl>
                <div class="alert alert-info mb-0">Plan değişikliği için destek ile iletişime geçin.</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Şifre değiştir</div>
            <div class="card-body">
                <form method="post" asp-page-handler="ChangePassword">
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Password.CurrentPassword" class="form-label"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.NewPassword" class="form-label"></label>
                        <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        <div class="form-text">En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary">Şifreyi değiştir</button>
                </form>
            </div>
        </div>
    </div>
</div>
