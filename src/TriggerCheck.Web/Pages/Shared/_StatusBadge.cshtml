@model TriggerCheck.Domain.Entities.MonitorStatus
@{
    var cls = Model switch
    {
        MonitorStatus.Up => "status-up",
        MonitorStatus.Down => "status-down",
        MonitorStatus.Paused => "status-paused",
        _ => "status-pending"
    };
}
<span class="status @cls">@Fmt.StatusName(Model)</span>
