@model TriggerCheck.Domain.Entities.MonitorStatus
@{
    var cls = Model switch
    {
        MonitorStatus.Up => "bg-success",
        MonitorStatus.Down => "bg-danger",
        MonitorStatus.Paused => "bg-secondary",
        _ => "bg-warning text-dark"
    };
    var text = Fmt.StatusName(Model);
}
<span class="badge @cls">@text</span>
