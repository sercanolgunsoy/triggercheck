@* Split-screen layout for the sign-in page: brand panel on the left, form on the right. *@
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TriggerCheck</title>
    <partial name="_ThemeScript" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth">
    <aside class="auth-aside">
        <a class="brand text-decoration-none" href="/">@Icons.Logo(32) TriggerCheck</a>
        <div>
            <h2 class="mb-3">@L["Know it's down before your customers do."]</h2>
            <p class="mb-4">@L["Uptime monitoring for websites, APIs and servers, with instant alerts and a clear incident history."]</p>
            <div class="mock" aria-hidden="true">
                <div class="mock-body">
                    @foreach (var (name, status, ms) in new[] { ("Website", MonitorStatus.Up, "182 ms"), ("Checkout API", MonitorStatus.Up, "96 ms"), ("Database", MonitorStatus.Down, "—") })
                    {
                        <div class="mock-row"><div class="nm"><partial name="_StatusBadge" model="status" /> <span>@name</span></div><div class="meta">@ms</div></div>
                    }
                </div>
            </div>
        </div>
        <small class="text-secondary">&copy; @DateTime.UtcNow.Year TriggerCheck</small>
    </aside>
    <div class="auth-main">
        <div class="d-flex justify-content-between align-items-center gap-2">
            <a class="d-inline-flex d-lg-none align-items-center gap-2 fw-bold text-body text-decoration-none" href="/">@Icons.Logo(28) TriggerCheck</a>
            <a class="d-none d-lg-inline-flex align-items-center gap-1 small text-muted" href="/">← @L["Back to website"]</a>
            <div class="d-flex gap-2"><partial name="_Toolbar" /></div>
        </div>
        <div class="auth-form">
            @RenderBody()
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
