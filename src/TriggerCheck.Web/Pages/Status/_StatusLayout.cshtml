@* Layout of the public status pages: no scripts at all (pages are output-cached, so a nonce could not match) and no
   links into the panel. ViewData: "Title", "NoIndex" (bool), "Base" (the page's own base path). *@
@{
    var basePath = ViewData["Base"] as string;
    // Path only (never the query string: the page is cached and must not echo request input); the public path on custom domains.
    var here = TriggerCheck.Web.StatusPages.CustomDomainMiddleware.PublicPath(Context);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["NoIndex"] is true) { <meta name="robots" content="noindex, nofollow" /> }
    <title>@ViewData["Title"]</title>
    @if (ViewData["Title"] is { } statusTitle)
    {
        <meta name="description" content="@L["Current status, uptime and incident history of {0}.", statusTitle]" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@statusTitle" />
        <meta property="og:description" content="@L["Current status, uptime and incident history of {0}.", statusTitle]" />
    }
    <partial name="_HeadIcons" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (basePath is not null) { <link rel="alternate" type="application/atom+xml" title="@ViewData["Title"]" href="@(basePath)/feed" /> }
</head>
<body>
<a class="skip-link" href="#main-content">@L["Skip to main content"]</a>
<div class="status-public">
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="mt-5 pt-3 border-top small text-muted d-flex flex-wrap gap-3 justify-content-between">
        <span>@L["Powered by TriggerCheck"]</span>
        <span>
            <a class="text-muted" href="/set-language?culture=en&amp;returnUrl=@Uri.EscapeDataString(here)" lang="en">English</a> ·
            <a class="text-muted" href="/set-language?culture=tr&amp;returnUrl=@Uri.EscapeDataString(here)" lang="tr">Türkçe</a>
        </span>
    </footer>
</div>
</body>
</html>
