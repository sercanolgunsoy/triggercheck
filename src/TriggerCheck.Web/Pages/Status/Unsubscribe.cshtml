@page "/status/{slug}/unsubscribe"
@model TriggerCheck.Web.Pages.Status.UnsubscribeModel
@{
    Layout = "_StatusLayout";
    ViewData["Title"] = Model.Ref.Title;
    ViewData["NoIndex"] = true;
    ViewData["Heading"] = L["Unsubscribe"].Value;
    ViewData["Button"] = L["Unsubscribe"].Value;
    ViewData["DoneText"] = L["You are unsubscribed and will not receive further e-mails from this status page."].Value;
}
<partial name="_SubscriptionLink" model="Model" />
