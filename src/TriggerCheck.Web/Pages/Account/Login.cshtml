@page
@model TriggerCheck.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = L["Sign in"]; Layout = "_AuthLayout"; }
<h1 class="mb-2">@L["Welcome back"]</h1>
<p class="text-muted mb-4">@L["Sign in to your TriggerCheck workspace."]</p>
@if (Model.Message is not null) { <div class="alert alert-warning">@Model.Message</div> }
<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@L["E-mail"]</label>
        <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" placeholder="name@company.com" autofocus />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">@L["Password"]</label>
        <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-4">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">@L["Remember me"]</label>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">@L["Sign in"]</button>
</form>
<p class="text-muted small mt-4 mb-0">@L["Don't have an account?"] <a href="/Account/Register">@L["Start your free trial"]</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
