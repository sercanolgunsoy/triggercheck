@page
@{ ViewData["Title"] = L["Access denied"]; }
<div class="card mx-auto mt-4" style="max-width: 520px">
    <div class="card-body empty-state">
        <span class="icon-wrap" style="background: var(--tc-down-soft); color: var(--tc-down)">@Icons.Get("lock", 22)</span>
        <h1 class="h4 text-body">@L["Access denied"]</h1>
        <p class="mb-4">@L["You do not have permission to view this page."]</p>
        <a class="btn btn-primary" href="/">@L["Go to home page"]</a>
    </div>
</div>
