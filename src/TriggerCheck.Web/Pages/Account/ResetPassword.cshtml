@page
@model TriggerCheck.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = L["Choose a new password"]; Layout = "_AuthLayout"; }
<h1 class="mb-2">@L["Choose a new password"]</h1>
@if (Model.Done)
{
    <p class="text-muted mb-4" data-testid="reset-done">@L["Your password was changed. You can sign in now."]</p>
    <a class="btn btn-primary w-100" href="/Account/Login">@L["Sign in"]</a>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <input type="hidden" asp-for="Input.UserId" />
        <input type="hidden" asp-for="Input.Code" />
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">@L["New password"]</label>
            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="new-password" autofocus />
            <div class="form-text">@L["At least 8 characters, with an uppercase letter, a lowercase letter and a digit."]</div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">@L["Confirm new password"]</label>
            <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100">@L["Change password"]</button>
    </form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
