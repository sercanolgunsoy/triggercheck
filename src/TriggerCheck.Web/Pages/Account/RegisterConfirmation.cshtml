@page
@{ ViewData["Title"] = L["Check your inbox"]; Layout = "_AuthLayout"; }
<h1 class="mb-2">@L["Check your inbox"]</h1>
<p class="text-muted mb-4">@L["If the address can be used, we have sent you an e-mail. Open the link in it to confirm your address, then sign in."]</p>
<p class="text-muted small">@L["Paid plans start with a free trial once per address and company domain; if yours already had one, the e-mail tells you which plan your workspace starts on."]</p>
<p class="text-muted small">@L["Nothing arrived after a few minutes? Check your spam folder or sign up again to get a new link."]</p>
<a class="btn btn-primary w-100" href="/Account/Login">@L["Sign in"]</a>
