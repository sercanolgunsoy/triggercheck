@page
@model TriggerCheck.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = L["Forgot password"]; Layout = "_AuthLayout"; }
<h1 class="mb-2">@L["Forgot password"]</h1>
@if (Model.Sent)
{
    <p class="text-muted mb-4" data-testid="reset-sent">@L["If an account exists for this address, we have sent a link to choose a new password. The link is valid for one day."]</p>
}
else
{
    <p class="text-muted mb-4">@L["Enter your e-mail address and we will send you a link to choose a new password."]</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">@L["E-mail"]</label>
            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100">@L["Send reset link"]</button>
    </form>
}
<p class="text-muted small mt-4 mb-0"><a href="/Account/Login">@L["Back to sign in"]</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
