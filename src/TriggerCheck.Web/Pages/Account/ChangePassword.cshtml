@page
@model TriggerCheck.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = L["Change password"]; Layout = "_AuthLayout"; }
<h1 class="mb-2">@L["Change password"]</h1>
@if (Model.Required)
{
    <div class="alert alert-warning">@L["You must choose a new password before you continue."]</div>
}
<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.CurrentPassword" class="form-label">@L["Current password"]</label>
        <input asp-for="Input.CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" autofocus />
        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">@L["New password"]</label>
        <input asp-for="Input.NewPassword" class="form-control form-control-lg" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label">@L["Confirm new password"]</label>
        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">@L["Change password"]</button>
</form>
<form method="post" asp-page="/Account/Logout" class="mt-3 text-center">
    <button type="submit" class="btn btn-link text-muted small">@L["Sign out"]</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
