@page
@model TriggerCheck.Web.Pages.Account.RegisterModel
@{ ViewData["Title"] = L["Create your account"]; Layout = "_AuthLayout"; }
<h1 class="mb-2">@L["Create your account"]</h1>
<p class="text-muted mb-4">@L["Try any plan free for {0} days. No credit card required.", Model.TrialDays]</p>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.CompanyName" class="form-label">@L["Company name"]</label>
        <input asp-for="Input.CompanyName" class="form-control" autocomplete="organization" autofocus />
        <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.FullName" class="form-label">@L["Your name"]</label>
        <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="Input.FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@L["E-mail"]</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="name@company.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">@L["Password"]</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <div class="form-text">@L["At least 8 characters, with an uppercase letter, a lowercase letter and a digit."]</div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.PlanId" class="form-label">@L["Plan"]</label>
        <select asp-for="Input.PlanId" class="form-select">
            @foreach (var p in Model.Plans)
            {
                <option value="@p.Id">@p.Name · @(p.MonthlyPrice == 0 ? L["Free"].Value : Fmt.Price(p.MonthlyPrice) + " " + L["/ month"].Value) · @L["Up to {0} monitors", Fmt.Number(p.MaxMonitors)]</option>
            }
        </select>
        <div class="form-text">@L["Paid plans start with a free trial; you can subscribe or change the plan later on the Billing page."]</div>
        <span asp-validation-for="Input.PlanId" class="text-danger"></span>
    </div>
    @* Honeypot: invisible to people and screen readers; bots that fill it get the normal result page and no account. *@
    <div style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden" aria-hidden="true">
        <label for="Input_Website">@L["Website"]</label>
        <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
    </div>
    <div class="form-check mb-4">
        <input asp-for="Input.AcceptTerms" class="form-check-input" />
        <label asp-for="Input.AcceptTerms" class="form-check-label">@L["I accept the terms of service and the privacy policy"]</label>
        <span asp-validation-for="Input.AcceptTerms" class="text-danger d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">@L["Create account"]</button>
</form>
<p class="text-muted small mt-4 mb-0">@L["Already have an account?"] <a href="/Account/Login">@L["Sign in"]</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
