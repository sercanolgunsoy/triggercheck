@page
@model PricingModel
@inject Microsoft.Extensions.Options.IOptions<TriggerCheck.Web.Billing.BillingOptions> Billing
@{
    ViewData["Title"] = L["Pricing"].Value;
    ViewData["FullTitle"] = L["Uptime monitoring pricing and plans - TriggerCheck"].Value;
    ViewData["Description"] = L["Compare TriggerCheck plans: check intervals, monitor limits, check history, SMS and voice call alerts and AI features. Try any paid plan free for {0} days.", Billing.Value.TrialDays].Value;
    Layout = "_MarketingLayout";
    var plans = Model.Plans;
    var featured = Marketing.FeaturedIndex(plans.Count);
    var mailto = $"mailto:{Model.ContactEmail}?subject={Uri.EscapeDataString("TriggerCheck")}";
    string Col(int i) => i == featured ? "col-featured" : "";

    // Rows of the comparison: a capability is either included in every plan (null) or decided by the plan.
    (string Label, Func<Plan, bool>? Has) Row(string label, Func<Plan, bool>? has = null) => (label, has);
    var groups = new (string Group, (string Label, Func<Plan, bool>? Has)[] Rows)[]
    {
        (L["Checks"].Value, [Row(L["HTTP(S) status checks"].Value), Row(L["Keyword checks"].Value), Row(L["TCP port checks"].Value), Row(L["Ping checks"].Value),
            Row(L["Custom timeout and failure threshold"].Value), Row(L["Pause and resume"].Value)]),
        (L["Alerts and incidents"].Value, [Row(L["E-mail alerts"].Value), Row(L["Webhook alerts"].Value), Row(L["Slack, Microsoft Teams and Telegram alerts"].Value),
            Row(L["SMS alerts"].Value, p => p.AllowsSms), Row(L["Voice call alerts"].Value, p => p.AllowsVoiceCall),
            Row(L["Recovery notifications"].Value), Row(L["Automatic incident log"].Value)]),
        (L["AI features"].Value, [.. AiFeatures.All.Select(f => Row(AiFeatureName(f.Name), p => AiFeatures.PlanAllows(p, f.Name)))]),
        (L["Reports"].Value, [Row(L["24 h, 7 day and 30 day uptime"].Value), Row(L["Response-time chart"].Value)]),
        (L["Team"].Value, [Row(L["Team members"].Value), Row(L["Admin and viewer roles"].Value, p => p.MaxUsers is not 1), Row(L["English and Turkish interface"].Value)]),
    };

    string AiFeatureName(string feature) => feature switch
    {
        AiFeatures.IncidentInterpretation => L["Incident summaries and likely causes"].Value,
        AiFeatures.SlowdownExplanation => L["Slowdown explanations"].Value,
        AiFeatures.SettingsSuggestions => L["Monitor setting suggestions"].Value,
        AiFeatures.MonitorSetupAssistant => L["Monitor setup assistant"].Value,
        AiFeatures.CorrelationGrouping => L["Grouping of related incidents"].Value,
        AiFeatures.NarrativeReport => L["Weekly and monthly reports"].Value,
        AiFeatures.QuestionAnswer => L["Questions in natural language"].Value,
        AiFeatures.PostmortemDraft => L["Postmortem and status page drafts"].Value,
        _ => feature,
    };

    // Shared by the FAQ markup and its FAQPage structured data (the two must say the same thing).
    var faq = new[] {
        (L["How does the check interval work?"].Value, L["Your plan sets the fastest interval you can use. Each monitor can be checked at that interval or any slower one, for example every 1 or 5 minutes."].Value),
        (L["Will I get an alert for every failed check?"].Value, L["No. A monitor is marked down only after the number of consecutive failures you choose. You get one alert when it goes down and one when it recovers."].Value),
        (L["What happens when I reach my monitor limit?"].Value, L["Existing monitors keep running. To add more, remove one you no longer need or move to a larger plan."].Value),
        (L["How long do you keep check results?"].Value, L["Check results are kept for the number of days in your plan and deleted automatically after that. Incidents stay in your history."].Value),
        (L["Can I change plans later?"].Value, L["Yes. Upgrade, downgrade or cancel at any time on the Billing page; your monitors and history stay as they are."].Value),
        (L["How does the free trial work?"].Value, L["Paid plans start with a {0}-day free trial, no credit card required. Subscribe before it ends to keep the plan; otherwise your workspace moves to the free plan.", Billing.Value.TrialDays].Value),
        (L["Do I need to install anything?"].Value, L["No. All checks run from our servers against your public addresses. There is no agent or code to install."].Value) };
    var faqLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org", ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(x => new Dictionary<string, object>
        {
            ["@type"] = "Question", ["name"] = x.Item1,
            ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = x.Item2 },
        }).ToArray(),
    };
}
@section Head {
    <!script type="application/ld+json">@Seo.JsonLd(Marketing.SoftwareApplication(ViewContext.HttpContext, plans, L["Uptime monitoring for websites, APIs and servers. Know about downtime before your customers do."].Value))</!script>
    <!script type="application/ld+json">@Seo.JsonLd(faqLd)</!script>
}

<section class="hero pb-5">
    <div class="container text-center">
        <span class="eyebrow"><span class="pill">@L["Pricing"]</span> @L["Every check type on every plan"]</span>
        <h1 class="display-title mt-4 mb-3">@L["Pricing that is"] <span class="gradient-text">@L["simple and transparent."]</span></h1>
        <p class="lead-lg mx-auto mb-5">@L["Every plan includes every check type and e-mail, webhook and chat alerts. Plans differ in how fast and how much you can monitor, SMS and voice call alerts, and AI features."]</p>
        <h2 class="visually-hidden">@L["Plans"]</h2>
        <div class="text-start">
            <partial name="_PlanCards" model="new PlanCardsModel(plans, Model.ContactEmail)" />
        </div>
        <p class="billing-note mt-4 mb-0">@L["Prices in US dollars, excluding taxes."]</p>
    </div>
</section>

@if (plans.Count > 0)
{
<section class="section pt-4" id="compare">
    <div class="container">
        <div class="section-head">
            <div class="kicker">@L["Compare plans"]</div>
            <h2>@L["Find the right fit"]</h2>
        </div>
        <div class="compare">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col" style="min-width: 220px"></th>
                            @for (var i = 0; i < plans.Count; i++)
                            {
                                <th scope="col" class="@Col(i)" style="min-width: 130px">@plans[i].Name
                                    <small>@(plans[i].MonthlyPrice == 0 ? L["Free"].Value : Fmt.Price(plans[i].MonthlyPrice) + " " + L["/ month"].Value)</small></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="group"><td colspan="@(plans.Count + 1)">@L["Limits"]</td></tr>
                        <tr><td>@L["Monitors"]</td>@for (var i = 0; i < plans.Count; i++) { <td class="@Col(i)">@Fmt.Number(plans[i].MaxMonitors)</td> }</tr>
                        <tr><td>@L["Fastest check interval"]</td>@for (var i = 0; i < plans.Count; i++) { <td class="@Col(i) fw-semibold">@Fmt.Interval(plans[i].MinIntervalSeconds)</td> }</tr>
                        <tr><td>@L["Check history"]</td>@for (var i = 0; i < plans.Count; i++) { <td class="@Col(i)">@L["{0} days", plans[i].RetentionDays]</td> }</tr>
                        <tr><td>@L["AI requests per month"]</td>@for (var i = 0; i < plans.Count; i++) { <td class="@Col(i)">@(plans[i].AiMonthlyCallLimit > 0 && AiFeatures.Parse(plans[i].AiFeatures).Count > 0 ? Fmt.Number(plans[i].AiMonthlyCallLimit) : "–")</td> }</tr>
                        @foreach (var (group, rows) in groups)
                        {
                            <tr class="group"><td colspan="@(plans.Count + 1)">@group</td></tr>
                            @foreach (var (label, has) in rows)
                            {
                                <tr>
                                    <td>@label</td>
                                    @for (var i = 0; i < plans.Count; i++)
                                    {
                                        <td class="@Col(i)">@if (label == L["Team members"].Value) { <span>@(plans[i].MaxUsers is int mu ? Fmt.Number(mu) : L["Unlimited"].Value)</span> }
                                            else if (has is null || has(plans[i])) { <span class="yes" title="@L["Included"]">@Icons.Get("check", 18)<span class="visually-hidden">@L["Included"]</span></span> }
                                            else { <span class="no" title="@L["Not included"]">@Icons.Get("x", 16)<span class="visually-hidden">@L["Not included"]</span></span> }</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
}

<section class="section section-alt" id="faq">
    <div class="container" style="max-width: 820px">
        <div class="section-head">
            <div class="kicker">@L["FAQ"]</div>
            <h2>@L["Frequently asked questions"]</h2>
        </div>
        <div class="faq">
            @foreach (var (q, a) in faq)
            {
                <details>
                    <summary>@q @Icons.Get("chevron-down")</summary>
                    <p>@a</p>
                </details>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="cta-band">
            <h2>@L["Not sure which plan fits?"]</h2>
            <p>@L["Tell us what you need to monitor and we'll recommend a plan."]</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-light btn-lg" href="@mailto">@L["Contact us"]</a>
                <a class="btn btn-outline-light btn-lg" href="@Seo.Href("/Features")">@L["Explore features"]</a>
            </div>
        </div>
    </div>
</section>
