<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TriggerCheck.Monitoring\TriggerCheck.Monitoring.csproj" />
    <ProjectReference Include="..\TriggerCheck.Infrastructure\TriggerCheck.Infrastructure.csproj" />
    <ProjectReference Include="..\TriggerCheck.Ai\TriggerCheck.Ai.csproj" />
    <!-- OPS-1 / OPS-2: loaded by name by EF (DatabaseOptions); referenced so they are deployed with the app. -->
    <ProjectReference Include="..\TriggerCheck.Migrations.Sqlite\TriggerCheck.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\TriggerCheck.Migrations.Postgres\TriggerCheck.Migrations.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- FEAT-10 PDF reports: MIT licensed, fully managed (no native dependency in the container). -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roboto (Apache License 2.0, see Reporting/Fonts/Roboto-LICENSE.txt): embedded so PDFs render the same on hosts without fonts. -->
    <EmbeddedResource Include="Reporting\Fonts\*.ttf" LogicalName="TriggerCheck.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
