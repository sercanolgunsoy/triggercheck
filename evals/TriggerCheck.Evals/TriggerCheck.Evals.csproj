<Project Sdk="Microsoft.NET.Sdk">

  <!-- AI-11 eval harness: labelled scenarios -> production context providers + interpreter -> grader -> report.
       Runs against FakeAiClient by default (CI / tests); the real Claude API only with an explicit flag and key. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriggerCheck.Ai\TriggerCheck.Ai.csproj" />
  </ItemGroup>

</Project>
