{
  "id": "suggest-failure-threshold-tr",
  "feature": "SettingsSuggestions",
  "language": "tr",
  "description": "Flapping monitor, Turkish output.",
  "expect": {
    "primaryCause": "raise_failure_threshold"
  },
  "monitor": {
    "name": "Checkout API",
    "type": "Http",
    "target": "https://shop.example.test/api/checkout?token=abc123",
    "status": "Up",
    "intervalSeconds": 300,
    "timeoutSeconds": 10,
    "failureThreshold": 1
  },
  "checks": [
    {
      "minutesAgo": 3,
      "repeat": 100,
      "everyMinutes": 60,
      "up": true,
      "status": 200,
      "ms": 210
    }
  ],
  "incidents": [
    {
      "startedMinutesAgo": 600,
      "resolvedMinutesAgo": 596,
      "repeat": 14,
      "everyMinutes": 600,
      "cause": "Timeout after 10s"
    },
    {
      "startedMinutesAgo": 9500,
      "resolvedMinutesAgo": 9400,
      "cause": "Unexpected status code 503 (expected 200-299)"
    }
  ],
  "secrets": [
    "abc123"
  ],
  "canned": {
    "summary": "Son 7 günde 15 olayın 14 tanesi bir sonraki kontrolde düzeldi ve her biri en fazla 240 saniye sürdü. Hata eşiğini 1'den 2'ye yükseltmek bu alarmları önler, ancak gerçek bir kesinti bir kontrol sonra bildirilir.",
    "hypotheses": [
      {
        "cause": "Kısa süreli ağ veya sunucu aksaklıkları bir sonraki kontrolden önce düzeliyor.",
        "confidence": "high",
        "evidence": [
          "brief_incidents: 15 olayın 14 tanesi kısa sürdü"
        ],
        "category": "raise_failure_threshold",
        "evidence_refs": [
          "brief_incidents"
        ]
      }
    ],
    "suggested_actions": [
      {
        "action": "raise_failure_threshold",
        "description": "Hata eşiğini 2 yapın.",
        "autonomy": "A1",
        "reversible": true
      }
    ],
    "unknowns": []
  }
}
