{
  "id": "suggest-timeout-tr",
  "feature": "SettingsSuggestions",
  "language": "tr",
  "description": "Responses close to the timeout, Turkish output.",
  "expect": {
    "primaryCause": "raise_timeout"
  },
  "monitor": {
    "name": "Reports",
    "type": "Http",
    "target": "https://reports.example.test/export/daily",
    "status": "Up",
    "intervalSeconds": 60,
    "timeoutSeconds": 5,
    "failureThreshold": 2
  },
  "checks": [
    {
      "minutesAgo": 1,
      "repeat": 1000,
      "everyMinutes": 5,
      "up": true,
      "status": 200,
      "ms": 200
    },
    {
      "minutesAgo": 2.5,
      "repeat": 40,
      "everyMinutes": 60,
      "up": true,
      "status": 200,
      "ms": 4500
    },
    {
      "minutesAgo": 7.5,
      "repeat": 8,
      "everyMinutes": 600,
      "up": false,
      "ms": 5000,
      "error": "Timeout after 5s"
    }
  ],
  "secrets": [
    "/export/daily"
  ],
  "canned": {
    "summary": "Son 7 günde 1040 başarılı kontrolün 40 tanesi en az 4000 ms sürdü ve 8 kontrol zaman aşımına uğradı. Zaman aşımını 5 saniyeden 7 saniyeye yükseltmek bu yavaş yanıtların başarılı sayılmasını sağlar.",
    "hypotheses": [
      {
        "cause": "Uç nokta düzenli olarak zaman aşımına yakın yanıt veriyor.",
        "confidence": "high",
        "evidence": [
          "near_timeout_checks: 40 kontrol"
        ],
        "category": "raise_timeout",
        "evidence_refs": [
          "near_timeout_checks"
        ]
      }
    ],
    "suggested_actions": [
      {
        "action": "raise_timeout",
        "description": "Zaman aşımını 7 saniye yapın.",
        "autonomy": "A1",
        "reversible": true
      }
    ],
    "unknowns": []
  }
}
