{
  "id": "pm-dns-nxdomain",
  "feature": "PostmortemDraft",
  "language": "en",
  "description": "DNS record disappeared after a zone change.",
  "expect": {
    "primaryCause": "dns_failure"
  },
  "monitor": {
    "name": "Shop API",
    "type": "Http",
    "target": "https://shop.example.test/api/health?key=planted-path-value",
    "status": "Up",
    "certExpiresInDays": 60
  },
  "incident": {
    "startedMinutesAgo": 90,
    "resolvedMinutesAgo": 30,
    "cause": "Name or service not known (shop.example.test)"
  },
  "checks": [
    {
      "minutesAgo": 29,
      "repeat": 1,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    },
    {
      "minutesAgo": 31,
      "repeat": 6,
      "everyMinutes": 10,
      "up": false,
      "ms": 15,
      "error": "Name or service not known (shop.example.test)",
      "dns": 2400
    },
    {
      "minutesAgo": 95,
      "repeat": 5,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    }
  ],
  "canned": {
    "likely_cause": {
      "category": "dns",
      "confidence": "high",
      "text": "Name resolution failed for the host during the whole incident ({{incident.error}}), so no connection could be made."
    },
    "customer_message": "{{service}} could not be reached from {{incident.started_at}} to {{incident.resolved_at}} because its address could not be looked up. The issue is resolved and the service is reachable again.",
    "unknowns": []
  }
}
