{
  "id": "pm-connection-refused-tr",
  "feature": "PostmortemDraft",
  "language": "tr",
  "description": "Web server process stopped (Turkish).",
  "expect": {
    "primaryCause": "connection_refused"
  },
  "monitor": {
    "name": "Shop API",
    "type": "Http",
    "target": "https://shop.example.test/api/health?key=planted-path-value",
    "status": "Up",
    "certExpiresInDays": 60
  },
  "incident": {
    "startedMinutesAgo": 70,
    "resolvedMinutesAgo": 50,
    "cause": "Connection refused (shop.example.test:443)"
  },
  "checks": [
    {
      "minutesAgo": 49,
      "repeat": 1,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    },
    {
      "minutesAgo": 51,
      "repeat": 2,
      "everyMinutes": 10,
      "up": false,
      "ms": 12,
      "error": "Connection refused (shop.example.test:443)",
      "dns": 4
    },
    {
      "minutesAgo": 75,
      "repeat": 5,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    }
  ],
  "canned": {
    "likely_cause": {
      "category": "connection_refused",
      "confidence": "high",
      "text": "Sunucu {{incident.duration}} boyunca bağlantıları reddetti; web sunucusu süreci çalışmıyordu."
    },
    "customer_message": "{{service}} {{incident.started_at}} ile {{incident.resolved_at}} arasında ({{incident.duration}}) erişilemedi. Sorun giderildi ve hizmet yeniden normal çalışıyor. Yaşananları inceliyoruz.",
    "unknowns": []
  }
}
