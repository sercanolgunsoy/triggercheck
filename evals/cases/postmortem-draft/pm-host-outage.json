{
  "id": "pm-host-outage",
  "feature": "PostmortemDraft",
  "language": "en",
  "description": "The whole host went down: other monitors on it failed too.",
  "expect": {
    "primaryCause": "host_outage"
  },
  "monitor": {
    "name": "Shop API",
    "type": "Http",
    "target": "https://shop.example.test/api/health?key=planted-path-value",
    "status": "Up",
    "certExpiresInDays": 60
  },
  "incident": {
    "startedMinutesAgo": 100,
    "resolvedMinutesAgo": 40,
    "cause": "Connection timed out (shop.example.test:443)"
  },
  "checks": [
    {
      "minutesAgo": 39,
      "repeat": 1,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    },
    {
      "minutesAgo": 41,
      "repeat": 6,
      "everyMinutes": 10,
      "up": false,
      "ms": 10000,
      "error": "Connection timed out (shop.example.test:443)",
      "dns": 4
    },
    {
      "minutesAgo": 105,
      "repeat": 5,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    }
  ],
  "canned": {
    "likely_cause": {
      "category": "host_outage",
      "confidence": "high",
      "text": "Other monitors on the same host failed at the same time, so the whole server was unavailable for {{incident.duration}}."
    },
    "customer_message": "Several services, including {{service}}, were unavailable from {{incident.started_at}} to {{incident.resolved_at}}. Our servers are running normally again.",
    "unknowns": []
  },
  "sameHost": [
    {
      "name": "Shop Admin",
      "type": "Http",
      "target": "https://shop.example.test/admin",
      "status": "Down",
      "openIncident": true
    },
    {
      "name": "Shop Images",
      "type": "Http",
      "target": "https://shop.example.test/img",
      "status": "Down",
      "openIncident": true
    }
  ]
}
