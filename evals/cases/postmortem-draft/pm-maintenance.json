{
  "id": "pm-maintenance",
  "feature": "PostmortemDraft",
  "language": "en",
  "description": "Service failed right after a planned maintenance window.",
  "expect": {
    "primaryCause": "maintenance_aftermath"
  },
  "monitor": {
    "name": "Shop API",
    "type": "Http",
    "target": "https://shop.example.test/api/health?key=planted-path-value",
    "status": "Up",
    "certExpiresInDays": 60
  },
  "incident": {
    "startedMinutesAgo": 60,
    "resolvedMinutesAgo": 30,
    "cause": "HTTP 503 (expected 200-299)"
  },
  "checks": [
    {
      "minutesAgo": 29,
      "repeat": 1,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    },
    {
      "minutesAgo": 31,
      "repeat": 3,
      "everyMinutes": 10,
      "up": false,
      "ms": 200,
      "error": "HTTP 503 Service Unavailable",
      "status": 503
    },
    {
      "minutesAgo": 70,
      "repeat": 3,
      "everyMinutes": 10,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 140
    }
  ],
  "canned": {
    "likely_cause": {
      "category": "maintenance_related",
      "confidence": "high",
      "text": "The failures started when the planned maintenance window was still running and ended shortly after it, so the maintenance work most likely caused them."
    },
    "customer_message": "{{service}} was unavailable from {{incident.started_at}} to {{incident.resolved_at}} during planned maintenance work. Everything is working normally again.",
    "unknowns": []
  },
  "maintenance": [
    {
      "startedMinutesAgo": 90,
      "endedMinutesAgo": 35
    }
  ]
}
