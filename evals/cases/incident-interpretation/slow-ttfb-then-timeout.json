      "ms": 10000,
      "error": "Timeout after 10 s",
      "dns": 4,
      "connect": 12,
      "tls": 25
    },
    {
      "minutesAgo": 5,
      "repeat": 2,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 8100,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 8000
    },
    {
      "minutesAgo": 7,
      "repeat": 2,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 4100,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 4000
    },
    {
      "minutesAgo": 9,
      "repeat": 2,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 1600,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 1500
    },
    {
      "minutesAgo": 11,
      "repeat": 10,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 150
    }
  ],
  "baselineMedianMs": 180,
  "canned": {
    "summary": "Shop API is down because responses became slower and slower until requests timed out after 10 seconds.",
    "hypotheses": [
      {
        "cause": "The server stopped responding in time: requests time out after TTFB had grown to 8 seconds.",
        "confidence": "high",
        "evidence": [
          "4 checks failed with 'Timeout after 10 s'",
          "TTFB rose from 150 ms to 1500, 4000 and 8000 ms in the preceding checks"
        ],
        "category": "timeout",
        "evidence_refs": [
          "error E1"
        ]
      }
    ],
    "suggested_actions": [
      {
        "action": "check_server_health",
