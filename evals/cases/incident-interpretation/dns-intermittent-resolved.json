{
  "id": "dns-intermittent-resolved",
  "feature": "IncidentInterpretation",
  "language": "en",
  "description": "Short DNS failure with slow DNS lookups before it.",
  "expect": {
    "primaryCause": "dns_failure"
  },
  "monitor": {
    "name": "Shop API",
    "type": "Http",
    "target": "https://shop.example.test/health",
    "status": "Down",
    "certExpiresInDays": 60
  },
  "incident": {
    "startedMinutesAgo": 25,
    "resolvedMinutesAgo": 18,
    "cause": "No such host is known. (shop.example.test:443)"
  },
  "checks": [
    {
      "minutesAgo": 1,
      "repeat": 17,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 150
    },
    {
      "minutesAgo": 19,
      "repeat": 7,
      "everyMinutes": 1,
      "up": false,
      "ms": 30,
      "error": "No such host is known. (shop.example.test:443)"
    },
    {
      "minutesAgo": 26,
      "repeat": 4,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 2000,
      "dns": 1800,
      "connect": 12,
      "tls": 25,
      "ttfb": 150
    },
    {
      "minutesAgo": 30,
      "repeat": 8,
      "everyMinutes": 1,
      "up": true,
      "status": 200,
      "ms": 180,
      "dns": 4,
      "connect": 12,
      "tls": 25,
      "ttfb": 150
    }
  ],
  "canned": {
    "summary": "Shop API was down for 7 minutes because the DNS name could not be resolved; DNS lookups had become very slow just before.",
    "hypotheses": [
      {
        "cause": "The DNS name server for shop.example.test failed to resolve the host.",
        "confidence": "high",
        "evidence": [
          "7 checks failed with 'No such host is known'",
          "DNS time rose from 4 ms to 1800 ms in the checks before the incident"
        ]
      }
    ],
    "suggested_actions": [
      {
        "action": "check_dns_configuration",
        "description": "Review the health of the authoritative name servers.",
        "autonomy": "A0",
        "reversible": true
      }
    ],
    "unknowns": []
  }
}
